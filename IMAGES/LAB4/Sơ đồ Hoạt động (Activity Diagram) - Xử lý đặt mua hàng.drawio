        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\n\n|Khách hàng|\nstart\n:Kích hoạt \&quot;Thực hiện đặt mua hàng\&quot; (UC7);\n\n|Hệ thống e-SHOPPING|\nif (Chưa đăng nhập?) then (Có)\n  :Yêu cầu Đăng nhập (UC6);\nelse (Không)\nendif\n\n|Khách hàng|\n:Chọn hình thức giao hàng (UC8);\n\n|Hệ thống e-SHOPPING|\n:Tính tổng trị giá giỏ hàng;\n\nif (Tổng &gt;= 5.000.000đ?) then (Đúng)\n  :Áp dụng miễn phí\\nchuyển phát nhanh trong ngày;\n  :Phí giao hàng = 0;\nelse (Sai)\n  if (Tổng &gt;= 1.000.000đ?) then (Đúng)\n    :Áp dụng miễn phí\\nchuyển phát nhanh;\n    :Phí giao hàng = 0;\n  else (Sai)\n    :Tính chi phí giao hàng theo\\nkhu vực và loại hình (UC9);\n  endif\nendif\n:Cộng phí giao hàng vào Tổng tiền;\n\n|Khách hàng|\n:Nhập thông tin người nhận hàng (UC10);\n:Nhập thông tin thẻ tín dụng (UC11);\n\n|Hệ thống e-SHOPPING|\n:Gửi yêu cầu xác thực thẻ;\n\n|Hệ thống TT trực tuyến|\n:Xác minh giao dịch (UC12);\n\n|Hệ thống e-SHOPPING|\nif (Giao dịch hợp lệ?) then (Không)\n  :Thông báo lỗi thanh toán;\n  |Khách hàng|\n  :Xử lý: Nhập lại thẻ hoặc Hủy;\n  stop\nelse (Có)\n  |Hệ thống e-SHOPPING|\n  :Ghi nhận đơn đặt hàng vào CSDL (UC13);\n  fork\n    |Khách hàng|\n    :Nhận thông báo\\nđặt hàng thành công (UC15);\n    stop\n  fork again\n    |Hệ thống e-SHOPPING|\n    :Gửi email xác nhận (UC14)\\n(Lọc bỏ thông tin thẻ);\n    stop\n  end fork\nendif\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="scYRvL25wRYaFaZ3OArn-1">
