        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\nskinparam componentStyle rectangle\n\nnode \&quot;Khách hàng (Client Tier)\&quot; {\n  component \&quot;Giao diện C# WinForms\\n(UI Layer)\&quot; as UI\n}\n\nnode \&quot;Hệ thống e-SHOPPING (Application Tier)\&quot; {\n  folder \&quot;Tầng Service / Adapter\&quot; {\n    component \&quot;CartService\\n(Xử lý giỏ hàng)\&quot; as CartSvc\n    component \&quot;OrderService\\n(Xử lý đơn hàng)\&quot; as OrderSvc\n    component \&quot;PaymentAdapter\&quot; as PayAdapt\n    component \&quot;EmailAdapter\&quot; as MailAdapt\n    component \&quot;ProductAdapter\\n(Yêu cầu sản phẩm)\&quot; as ProdAdapt\n  }\n  folder \&quot;Tầng Dữ liệu (Data Layer)\&quot; {\n    component \&quot;DataAccessRepository\&quot; as DAL\n  }\n}\n\nnode \&quot;Cơ sở dữ liệu (Database Tier)\&quot; {\n  database \&quot;SQL Server\\n(eShopping_DB)\&quot; as DB\n}\n\nnode \&quot;Các hệ thống bên ngoài (External Systems)\&quot; {\n  component \&quot;Hệ thống Thanh toán\\ntrực tuyến\&quot; as ExtPay\n  component \&quot;Dịch vụ Email\\n(SMTP)\&quot; as ExtMail\n  component \&quot;Hệ thống Quản lý\\nSản phẩm\&quot; as ExtProd\n}\n\nUI .down.&gt; CartSvc : Gọi hàm nghiệp vụ\nUI .down.&gt; OrderSvc\nUI .down.&gt; ProdAdapt : Yêu cầu xem SP\n\nCartSvc .down.&gt; DAL\nOrderSvc .down.&gt; DAL\nOrderSvc .down.&gt; PayAdapt : Yêu cầu xác thực thẻ\nOrderSvc .down.&gt; MailAdapt : Yêu cầu gửi mail\n\nDAL .down.&gt; DB : Kết nối bằng ADO.NET/EF\n\nPayAdapt -down-&gt; ExtPay : API Bảo mật\nMailAdapt -down-&gt; ExtMail : SMTP/API\nProdAdapt -down-&gt; ExtProd : API (GET)\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="z22GkSBob3Ag29mGBQsV-1">
