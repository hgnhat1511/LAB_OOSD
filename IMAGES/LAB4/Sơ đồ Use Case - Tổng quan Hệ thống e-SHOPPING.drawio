        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\nleft to right direction\n\nactor \&quot;Khách hàng\&quot; as KH\nactor \&quot;&lt;&lt;Hệ thống ngoài&gt;&gt;\\nHệ thống quản lý\\nsản phẩm\&quot; as HTQLSP\nactor \&quot;&lt;&lt;Hệ thống ngoài&gt;&gt;\\nHệ thống dịch vụ\\nthanh toán trực tuyến\&quot; as HTTT\n\nrectangle \&quot;Hệ thống e-SHOPPING\&quot; {\n  usecase \&quot;Xem danh sách sản phẩm\&quot; as UC1\n  usecase \&quot;Xem chi tiết sản phẩm\&quot; as UC2\n  usecase \&quot;Thêm sản phẩm vào giỏ hàng\&quot; as UC3\n  usecase \&quot;Quản lý giỏ hàng\&quot; as UC4\n  usecase \&quot;Đăng nhập\&quot; as UC5\n  usecase \&quot;Đăng ký tài khoản\&quot; as UC6\n  usecase \&quot;Chọn hình thức giao hàng\&quot; as UC7\n  usecase \&quot;Tính chi phí giao hàng\&quot; as UC8\n  usecase \&quot;Nhập thông tin người nhận\&quot; as UC9\n  usecase \&quot;Thực hiện đặt mua hàng\&quot; as UC10\n  usecase \&quot;Thanh toán bằng thẻ tín dụng\&quot; as UC11\n  usecase \&quot;Xác minh giao dịch thanh toán\&quot; as UC12\n  usecase \&quot;Gửi email xác nhận đặt hàng\&quot; as UC13\n  usecase \&quot;Nhận kết quả đặt hàng\&quot; as UC14\n  usecase \&quot;Ghi nhận đơn đặt hàng\&quot; as UC15\n}\n\nKH -- UC1\nKH -- UC3\nKH -- UC4\nKH -- UC6\nKH -- UC10\n\nHTQLSP -- UC1\nHTQLSP -- UC2\n\nHTTT -- UC12\n\nUC3 .&gt; UC1 : &lt;&lt;extend&gt;&gt;\nUC3 .&gt; UC2 : &lt;&lt;extend&gt;&gt;\n\nUC10 .&gt; UC5 : &lt;&lt;include&gt;&gt;\nUC10 .&gt; UC7 : &lt;&lt;include&gt;&gt;\nUC10 .&gt; UC9 : &lt;&lt;include&gt;&gt;\nUC10 .&gt; UC11 : &lt;&lt;include&gt;&gt;\nUC10 .&gt; UC13 : &lt;&lt;include&gt;&gt;\nUC10 .&gt; UC14 : &lt;&lt;extend&gt;&gt;\n\nUC7 .&gt; UC8 : &lt;&lt;include&gt;&gt;\nUC11 .&gt; UC12 : &lt;&lt;include&gt;&gt;\nUC14 .&gt; UC15 : &lt;&lt;include&gt;&gt;\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="WlPFsTMMaSJH5iRzwVit-1">
