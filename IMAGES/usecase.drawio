        <UserObject label="" plantUmlData="{
  "data": "\n@startuml\ntitle HỆ THỐNG QUẢN LÝ ĐIỂM ĐỖ XE VÀ GIẤY PHÉP CƯ DÂN (CIV-05)\n\nleft to right direction\n\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam defaultFontSize 13\nskinparam actorStyle stickman\nskinparam usecase {\n  BackgroundColor #DDFBFC\n  BorderColor #0097A7\n}\nskinparam rectangle {\n  BorderColor #555555\n  BackgroundColor white\n}\n\nactor \"Cư dân\" as CD\nactor \"Quản trị viên\" as QTV\nactor \"Ban quản lý\\n(Admin)\" as BQL\nactor \"Bảo vệ\" as BV\nactor \"Camera AI\\n(Secondary Actor)\" as CAM\n\nrectangle \"HỆ THỐNG QUẢN LÝ ĐIỂM ĐỖ XE VÀ GIẤY PHÉP CƯ DÂN (CIV-05)\" {\n\n  usecase \"UC01: Đăng nhập hệ thống\" as UC01\n  usecase \"UC02: Quản lý tài khoản và phân quyền\" as UC02\n  usecase \"UC03: Thiết lập hạn ngạch căn hộ\" as UC03\n  usecase \"UC04: Quản lý khu vực đỗ xe\" as UC04\n  usecase \"UC05: Đăng ký phương tiện mới\" as UC05\n  usecase \"UC06: Cập nhật thông tin phương tiện\" as UC06\n  usecase \"UC07: Xét duyệt giấy phép đỗ xe\" as UC07\n  usecase \"UC08: Khóa/Thu hồi giấy phép\" as UC08\n  usecase \"UC09: Tra cứu thông tin phương tiện\" as UC09\n  usecase \"UC10: Ghi nhận xe ra/vào cổng\" as UC10\n  usecase \"UC11: Lập biên bản vi phạm\" as UC11\n  usecase \"UC12: Xử lý vi phạm\" as UC12\n  usecase \"UC13: Xem báo cáo, thống kê\" as UC13\n\n}\n\n@enduml\n",
  "config": null
}" id="EcHpITwzM71QpLGqOYCM-1">
