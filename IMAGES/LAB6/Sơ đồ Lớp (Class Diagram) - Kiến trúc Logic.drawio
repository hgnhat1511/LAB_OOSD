        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\nhide empty methods\n\npackage \&quot;QUẢN LÝ BỆNH NHÂN\&quot; {\n  class \&quot;BenhNhan\&quot; as BenhNhan {\n    maBenhNhan : String &lt;&lt;PK&gt;&gt;\n    hoTen : String\n    diaChi : String\n    ngaySinh : Date\n    soDienThoai : String\n    anh3x4 : String\n    --\n    dangKy()\n    capNhatThongTin()\n  }\n\n  class \&quot;PhieuDangKy\&quot; as PhieuDangKy {\n    maPhieuDangKy : String &lt;&lt;PK&gt;&gt;\n    maBenhNhan : String &lt;&lt;FK&gt;&gt;\n    ngayDangKy : Date\n    soTienPhaiNop : Decimal\n    trangThaiPhi : String\n    --\n    ghiNhanDangKy()\n    capNhatTrangThaiPhi()\n  }\n\n  class \&quot;HoSoBenhAn\&quot; as HoSoBenhAn {\n    maHoSo : String &lt;&lt;PK&gt;&gt;\n    maBenhNhan : String &lt;&lt;FK&gt;&gt;\n    ngayLap : Date\n    trangThai : String\n    --\n    taoHoSo()\n    traCuuHoSo()\n  }\n\n  class \&quot;LichKhamDinhKy\&quot; as LichKhamDinhKy {\n    maLichKham : String &lt;&lt;PK&gt;&gt;\n    maHoSo : String &lt;&lt;FK&gt;&gt;\n    ngayHen : Date\n    gioHen : Time\n    trangThai : String\n    --\n    datLich()\n    capNhatLich()\n  }\n}\n\npackage \&quot;NHÂN SỰ\&quot; {\n  class \&quot;BacSi\&quot; as BacSi {\n    maKhoa : String &lt;&lt;FK&gt;&gt;\n    chuyenMon : String\n    --\n    khamBenh()\n    lapToaThuoc()\n    chiDinhXetNghiem()\n  }\n\n  class \&quot;NhanVien\&quot; as NhanVien {\n    maNhanVien : String &lt;&lt;PK&gt;&gt;\n    hoTen : String\n    soDienThoai : String\n    vaiTro : String\n    trangThai : String\n    --\n    capNhatThongTin()\n  }\n}\n\npackage \&quot;KHÁM CHỮA BỆNH\&quot; {\n  class \&quot;Khoa\&quot; as Khoa {\n    maKhoa : String &lt;&lt;PK&gt;&gt;\n    tenKhoa : String\n    moTa : String\n  }\n\n  class \&quot;PhieuKham\&quot; as PhieuKham {\n    maPhieuKham : String &lt;&lt;PK&gt;&gt;\n    maHoSo : String &lt;&lt;FK&gt;&gt;\n    maNhanVien_BacSi : String &lt;&lt;FK&gt;&gt;\n    maKhoa : String &lt;&lt;FK&gt;&gt;\n    maLichKham : String &lt;&lt;FK, optional&gt;&gt;\n    ngayGioKham : DateTime\n    trieuChung : String\n    nhietDo : Decimal\n    huyetAp : String\n    loaiKham : String\n    --\n    taoPhieuKham()\n    capNhatThongTinKham()\n  }\n\n  class \&quot;XetNghiem\&quot; as XetNghiem {\n    maXetNghiem : String &lt;&lt;PK&gt;&gt;\n    maPhieuKham : String &lt;&lt;FK&gt;&gt;\n    maDichVu : String &lt;&lt;FK&gt;&gt;\n    ngayChiDinh : Date\n    ketQua : String\n    trangThai : String\n    --\n    taoChiDinh()\n    capNhatKetQua()\n  }\n\n  class \&quot;DichVuXetNghiem\&quot; as DichVuXetNghiem {\n    maDichVu : String &lt;&lt;PK&gt;&gt;\n    tenDichVu : String\n    donGia : Decimal\n  }\n\n  class \&quot;ToaThuoc\&quot; as ToaThuoc {\n    maToaThuoc : String &lt;&lt;PK&gt;&gt;\n    maPhieuKham : String &lt;&lt;FK&gt;&gt;\n    ngayLap : Date\n    ghiChu : String\n    --\n    lapToaThuoc()\n    xacNhanToaThuoc()\n  }\n\n  class \&quot;ChiTietToaThuoc\&quot; as ChiTietToaThuoc {\n    maChiTiet : String &lt;&lt;PK&gt;&gt;\n    maToaThuoc : String &lt;&lt;FK&gt;&gt;\n    maThuoc : String &lt;&lt;FK&gt;&gt;\n    lieuDung : String\n    cachDung : String\n    soLuong : Integer\n    thoiGianDung : String\n  }\n\n  class \&quot;Thuoc\&quot; as Thuoc {\n    maThuoc : String &lt;&lt;PK&gt;&gt;\n    tenThuoc : String\n    donViTinh : String\n    donGia : Decimal\n    soLuongTon : Integer\n  }\n}\n\npackage \&quot;THANH TOÁN VÀ THEO DÕI\&quot; {\n  class \&quot;ThanhToan\&quot; as ThanhToan {\n    maThanhToan : String &lt;&lt;PK&gt;&gt;\n    maPhieuDangKy : String &lt;&lt;FK, optional&gt;&gt;\n    maPhieuKham : String &lt;&lt;FK, optional&gt;&gt;\n    loaiThanhToan : String\n    soTien : Decimal\n    ngayThanhToan : Date\n    hinhThuc : String\n    trangThai : String\n    --\n    ghiNhanThanhToan()\n  }\n\n  class \&quot;TheoDoiSauDieuTri\&quot; as TheoDoiSauDieuTri {\n    maTheoDoi : String &lt;&lt;PK&gt;&gt;\n    maPhieuKham : String &lt;&lt;FK&gt;&gt;\n    maNhanVien : String &lt;&lt;FK&gt;&gt;\n    ngayGhiNhan : Date\n    dienBienBenh : String\n    tacDungPhu : String\n    hieuQuaDieuTri : String\n    --\n    ghiNhanTheoDoi()\n  }\n}\n\nBenhNhan \&quot;1\&quot; -down- \&quot;0..*\&quot; PhieuDangKy : đăng ký\nBenhNhan \&quot;1\&quot; -right- \&quot;1\&quot; HoSoBenhAn : sở hữu\nPhieuDangKy \&quot;0..1\&quot; -right- \&quot;1\&quot; HoSoBenhAn : có hồ sơ\nHoSoBenhAn \&quot;1\&quot; -down- \&quot;0..*\&quot; LichKhamDinhKy : có lịch hẹn\nNhanVien &lt;|-down- BacSi\nBacSi \&quot;1\&quot; -down- \&quot;0..*\&quot; PhieuKham : phụ trách\nKhoa \&quot;1\&quot; -down- \&quot;0..*\&quot; PhieuKham : tiếp nhận\nHoSoBenhAn \&quot;1\&quot; -down- \&quot;0..*\&quot; PhieuKham : ghi nhận\nNhanVien \&quot;1\&quot; -down- \&quot;0..*\&quot; PhieuDangKy : ghi nhận\nPhieuKham \&quot;1\&quot; -down- \&quot;0..*\&quot; XetNghiem : có chỉ định\nXetNghiem \&quot;0..*\&quot; -down- \&quot;1\&quot; DichVuXetNghiem : thuộc loại\nPhieuKham \&quot;1\&quot; -down- \&quot;0..1\&quot; ToaThuoc : kê đơn\nToaThuoc \&quot;1\&quot; -down- \&quot;1..*\&quot; ChiTietToaThuoc : gồm\nChiTietToaThuoc \&quot;0..*\&quot; -down- \&quot;1\&quot; Thuoc : tham chiếu\nPhieuDangKy \&quot;0..1\&quot; -down- \&quot;1\&quot; ThanhToan : viện phí\nPhieuKham \&quot;0..1\&quot; -down- \&quot;1\&quot; ThanhToan : viện phí\nPhieuKham \&quot;1\&quot; -down- \&quot;0..*\&quot; TheoDoiSauDieuTri : được theo dõi\nNhanVien \&quot;1\&quot; -down- \&quot;0..*\&quot; TheoDoiSauDieuTri : ghi nhận\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ray3hKAlm3kXC1MkNkXS-1">
