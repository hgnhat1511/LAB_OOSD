        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\nhide circle\n\nentity \&quot;BENH_NHAN\&quot; as BENH_NHAN {\n  * maBenhNhan : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  hoTen : NVARCHAR(100)\n  diaChi : NVARCHAR(255)\n  ngaySinh : DATE\n  soDienThoai : VARCHAR(15)\n  anh3x4 : NVARCHAR(255)\n}\n\nentity \&quot;HO_SO_BENH_AN\&quot; as HO_SO_BENH_AN {\n  * maHoSo : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  maBenhNhan : VARCHAR(20) &lt;&lt;FK, UNIQUE&gt;&gt;\n  ngayLap : DATE\n  trangThai : NVARCHAR(30)\n}\n\nentity \&quot;KHOA\&quot; as KHOA {\n  * maKhoa : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  tenKhoa : NVARCHAR(100)\n  moTa : NVARCHAR(255)\n}\n\nentity \&quot;BAC_SI\&quot; as BAC_SI {\n  * maBacSi : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  maKhoa : VARCHAR(20) &lt;&lt;FK&gt;&gt;\n  hoTen : NVARCHAR(100)\n  chuyenMon : NVARCHAR(100)\n  soDienThoai : VARCHAR(15)\n}\n\nentity \&quot;LICH_KHAM_DINH_KY\&quot; as LICH_KHAM_DINH_KY {\n  * maLichKham : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  maHoSo : VARCHAR(20) &lt;&lt;FK&gt;&gt;\n  ngayHen : DATE\n  gioHen : TIME\n  trangThai : NVARCHAR(30)\n  ghiChu : NVARCHAR(255)\n}\n\nentity \&quot;PHIEU_KHAM\&quot; as PHIEU_KHAM {\n  * maPhieuKham : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  maHoSo : VARCHAR(20) &lt;&lt;FK&gt;&gt;\n  maBacSi : VARCHAR(20) &lt;&lt;FK&gt;&gt;\n  maKhoa : VARCHAR(20) &lt;&lt;FK&gt;&gt;\n  maLichKham : VARCHAR(20) &lt;&lt;FK, NULL&gt;&gt;\n  ngayGioKham : DATETIME\n  trieuChung : NVARCHAR(500)\n  nhietDo : DECIMAL(4,1)\n  huyetAp : VARCHAR(20)\n  loaiKham : NVARCHAR(30)\n}\n\nentity \&quot;PHIEU_DANG_KY\&quot; as PHIEU_DANG_KY {\n  * maPhieuDangKy : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  maBenhNhan : VARCHAR(20) &lt;&lt;FK&gt;&gt;\n  ngayDangKy : DATE\n  soTienPhaiNop : DECIMAL(12,2)\n  trangThaiPhi : NVARCHAR(30)\n}\n\nentity \&quot;NHAN_VIEN\&quot; as NHAN_VIEN {\n  * maNhanVien : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  hoTen : NVARCHAR(100)\n  soDienThoai : VARCHAR(15)\n  vaiTro : NVARCHAR(50)\n  trangThai : NVARCHAR(30)\n}\n\nentity \&quot;TOA_THUOC\&quot; as TOA_THUOC {\n  * maToaThuoc : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  maPhieuKham : VARCHAR(20) &lt;&lt;FK, UNIQUE&gt;&gt;\n  ngayLap : DATE\n  ghiChu : NVARCHAR(500)\n}\n\nentity \&quot;THUOC\&quot; as THUOC {\n  * maThuoc : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  tenThuoc : NVARCHAR(150)\n  donViTinh : NVARCHAR(20)\n  donGia : DECIMAL(12,2)\n  soLuongTon : INT\n}\n\nentity \&quot;DICH_VU_XET_NGHIEM\&quot; as DICH_VU_XET_NGHIEM {\n  * maDichVu : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  tenDichVu : NVARCHAR(150)\n  donGia : DECIMAL(12,2)\n}\n\nentity \&quot;CHI_TIET_TOA_THUOC\&quot; as CHI_TIET_TOA_THUOC {\n  * maChiTiet : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  maToaThuoc : VARCHAR(20) &lt;&lt;FK&gt;&gt;\n  maThuoc : VARCHAR(20) &lt;&lt;FK&gt;&gt;\n  lieuDung : NVARCHAR(100)\n  cachDung : NVARCHAR(255)\n  soLuong : INT\n  thoiGianDung : NVARCHAR(100)\n}\n\nentity \&quot;XET_NGHIEM\&quot; as XET_NGHIEM {\n  * maXetNghiem : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  maPhieuKham : VARCHAR(20) &lt;&lt;FK&gt;&gt;\n  maDichVu : VARCHAR(20) &lt;&lt;FK&gt;&gt;\n  ngayChiDinh : DATE\n  ketQua : NVARCHAR(1000)\n  ngayCapNhat : DATE\n  trangThai : NVARCHAR(30)\n}\n\nentity \&quot;THANH_TOAN\&quot; as THANH_TOAN {\n  * maThanhToan : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  maPhieuDangKy : VARCHAR(20) &lt;&lt;FK, NULL&gt;&gt;\n  maPhieuKham : VARCHAR(20) &lt;&lt;FK, NULL&gt;&gt;\n  loaiThanhToan : NVARCHAR(50)\n  soTien : DECIMAL(12,2)\n  ngayThanhToan : DATETIME\n  hinhThuc : NVARCHAR(50)\n  trangThai : NVARCHAR(30)\n}\n\nentity \&quot;THEO_DOI_SAU_DIEU_TRI\&quot; as THEO_DOI_SAU_DIEU_TRI {\n  * maTheoDoi : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  maPhieuKham : VARCHAR(20) &lt;&lt;FK&gt;&gt;\n  maNhanVien : VARCHAR(20) &lt;&lt;FK&gt;&gt;\n  ngayGhiNhan : DATETIME\n  dienBienBenh : NVARCHAR(1000)\n  tacDungPhu : NVARCHAR(1000)\n  hieuQuaDieuTri : NVARCHAR(1000)\n  ghiChu : NVARCHAR(500)\n}\n\nBENH_NHAN ||..|| HO_SO_BENH_AN : có hồ sơ\nHO_SO_BENH_AN ||..o{ LICH_KHAM_DINH_KY : có lịch hẹn quản lý\nKHOA ||..o{ BAC_SI : đăng ký\nKHOA ||..o{ PHIEU_KHAM : tiếp nhận\nBAC_SI ||..o{ PHIEU_KHAM : phụ trách\nHO_SO_BENH_AN ||..o{ PHIEU_KHAM : có lần khám\nLICH_KHAM_DINH_KY ||..o| PHIEU_KHAM : phát sinh lần khám\nBENH_NHAN ||..o{ PHIEU_DANG_KY : đăng ký\nPHIEU_KHAM ||..o| TOA_THUOC : lập toa\nTOA_THUOC ||..|{ CHI_TIET_TOA_THUOC : gồm\nTHUOC ||..o{ CHI_TIET_TOA_THUOC : viện phí\nPHIEU_KHAM ||..o{ XET_NGHIEM : có chỉ định\nDICH_VU_XET_NGHIEM ||..o{ XET_NGHIEM : loại xét nghiệm\nPHIEU_DANG_KY ||..o| THANH_TOAN : phí đăng ký\nPHIEU_KHAM ||..o| THANH_TOAN : được kê\nPHIEU_KHAM ||..o{ THEO_DOI_SAU_DIEU_TRI : được theo dõi\nNHAN_VIEN ||..o{ THEO_DOI_SAU_DIEU_TRI : ghi nhận\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="nswxOeWqZkCYdFnaWc8O-1">
