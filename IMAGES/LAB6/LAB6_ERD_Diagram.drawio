        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntop to bottom direction\nhide circle\nskinparam linetype ortho\nskinparam shadowing false\nskinparam defaultFontSize 11\n\nentity \&quot;BENH_NHAN\&quot; as BN {\n-   maBenhNhan : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  hoTen : NVARCHAR(100)\n  diaChi : NVARCHAR(255)\n  ngaySinh : DATE\n  soDienThoai : VARCHAR(15)\n  anh3x4 : NVARCHAR(255)\n}\n\nentity \&quot;PHIEU_DANG_KY\&quot; as DK {\n-   maPhieuDangKy : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  maBenhNhan : VARCHAR(20) &lt;&lt;FK&gt;&gt;\n  ngayDangKy : DATE\n  soTienPhaiNop : DECIMAL(12,2)\n  trangThaiPhi : NVARCHAR(30)\n}\n\nentity \&quot;HO_SO_BENH_AN\&quot; as HS {\n-   maHoSo : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  maBenhNhan : VARCHAR(20) &lt;&lt;FK, UNIQUE&gt;&gt;\n  ngayLap : DATE\n  trangThai : NVARCHAR(30)\n}\n\nentity \&quot;KHOA\&quot; as K {\n-   maKhoa : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  tenKhoa : NVARCHAR(100)\n  moTa : NVARCHAR(255)\n}\n\nentity \&quot;BAC_SI\&quot; as BS {\n-   maBacSi : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  maKhoa : VARCHAR(20) &lt;&lt;FK&gt;&gt;\n  hoTen : NVARCHAR(100)\n  chuyenMon : NVARCHAR(100)\n  soDienThoai : VARCHAR(15)\n}\n\nentity \&quot;NHAN_VIEN\&quot; as NV {\n-   maNhanVien : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  hoTen : NVARCHAR(100)\n  soDienThoai : VARCHAR(15)\n  vaiTro : NVARCHAR(50)\n  trangThai : NVARCHAR(30)\n}\n\nentity \&quot;LICH_KHAM_DINH_KY\&quot; as LK {\n-   maLichKham : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  maHoSo : VARCHAR(20) &lt;&lt;FK&gt;&gt;\n  ngayHen : DATE\n  gioHen : TIME\n  trangThai : NVARCHAR(30)\n  ghiChu : NVARCHAR(255)\n}\n\nentity \&quot;PHIEU_KHAM\&quot; as PK {\n-   maPhieuKham : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  maHoSo : VARCHAR(20) &lt;&lt;FK&gt;&gt;\n  maBacSi : VARCHAR(20) &lt;&lt;FK&gt;&gt;\n  maKhoa : VARCHAR(20) &lt;&lt;FK&gt;&gt;\n  maLichKham : VARCHAR(20) &lt;&lt;FK, NULL&gt;&gt;\n  ngayGioKham : DATETIME\n  trieuChung : NVARCHAR(500)\n  nhietDo : DECIMAL(4,1)\n  huyetAp : VARCHAR(20)\n  loaiKham : NVARCHAR(30)\n}\n\nentity \&quot;TOA_THUOC\&quot; as TT {\n-   maToaThuoc : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  maPhieuKham : VARCHAR(20) &lt;&lt;FK, UNIQUE&gt;&gt;\n  ngayLap : DATE\n  ghiChu : NVARCHAR(500)\n}\n\nentity \&quot;THUOC\&quot; as TH {\n-   maThuoc : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  tenThuoc : NVARCHAR(150)\n  donViTinh : NVARCHAR(20)\n  donGia : DECIMAL(12,2)\n  soLuongTon : INT\n}\n\nentity \&quot;CHI_TIET_TOA_THUOC\&quot; as CTT {\n-   maChiTiet : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  maToaThuoc : VARCHAR(20) &lt;&lt;FK&gt;&gt;\n  maThuoc : VARCHAR(20) &lt;&lt;FK&gt;&gt;\n  lieuDung : NVARCHAR(100)\n  cachDung : NVARCHAR(255)\n  soLuong : INT\n  thoiGianDung : NVARCHAR(100)\n}\n\nentity \&quot;DICH_VU_XET_NGHIEM\&quot; as DV {\n-   maDichVu : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  tenDichVu : NVARCHAR(150)\n  donGia : DECIMAL(12,2)\n}\n\nentity \&quot;XET_NGHIEM\&quot; as XN {\n-   maXetNghiem : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  maPhieuKham : VARCHAR(20) &lt;&lt;FK&gt;&gt;\n  maDichVu : VARCHAR(20) &lt;&lt;FK&gt;&gt;\n  ngayChiDinh : DATE\n  ketQua : NVARCHAR(1000)\n  ngayCapNhat : DATE\n  trangThai : NVARCHAR(30)\n}\n\nentity \&quot;THANH_TOAN\&quot; as TTAN {\n-   maThanhToan : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  maPhieuDangKy : VARCHAR(20) &lt;&lt;FK, NULL&gt;&gt;\n  maPhieuKham : VARCHAR(20) &lt;&lt;FK, NULL&gt;&gt;\n  loaiThanhToan : NVARCHAR(50)\n  soTien : DECIMAL(12,2)\n  ngayThanhToan : DATETIME\n  hinhThuc : NVARCHAR(50)\n  trangThai : NVARCHAR(30)\n}\n\nentity \&quot;THEO_DOI_SAU_DIEU_TRI\&quot; as TD {\n-   maTheoDoi : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  maPhieuKham : VARCHAR(20) &lt;&lt;FK&gt;&gt;\n  maNhanVien : VARCHAR(20) &lt;&lt;FK&gt;&gt;\n  ngayGhiNhan : DATETIME\n  dienBienBenh : NVARCHAR(1000)\n  tacDungPhu : NVARCHAR(1000)\n  hieuQuaDieuTri : NVARCHAR(1000)\n  ghiChu : NVARCHAR(500)\n}\n\n&#39; Quan hệ bệnh nhân và hồ sơ\nBN ||--o{ DK : đăng ký\nBN ||--|| HS : có hồ sơ\nHS ||--o{ LK : có lịch hẹn\nHS ||--o{ PK : có lần khám\n\n&#39; Quan hệ bác sĩ, khoa và lần khám\nK ||--o{ BS : quản lý\nK ||--o{ PK : tiếp nhận\nBS ||--o{ PK : phụ trách\n&#39; Đã sửa lại dòng lỗi cú pháp ở đây thành \&quot;1 lịch khám có 0 hoặc 1 phiếu khám\&quot;\nLK ||--o| PK : phát sinh lần khám\n\n&#39; Quan hệ toa thuốc, danh mục thuốc và chi tiết\nPK ||--o| TT : lập toa\nTT ||--|{ CTT : gồm\nTH ||--o{ CTT : được kê\n\n&#39; Quan hệ xét nghiệm và dịch vụ\nPK ||--o{ XN : có chỉ định\nDV ||--o{ XN : loại xét nghiệm\n\n&#39; Quan hệ thanh toán\nDK ||--o{ TTAN : phí đăng ký\nPK ||--o{ TTAN : viện phí\n\n&#39; Quan hệ theo dõi sau điều trị\nPK ||--o{ TD : được theo dõi\nNV ||--o{ TD : ghi nhận\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="tgmEXfvFNNIJ0Vp-Fyiw-282">
