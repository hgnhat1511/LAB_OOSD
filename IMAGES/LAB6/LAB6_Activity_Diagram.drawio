        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle QUY TRÌNH KHÁM BỆNH VÀ LẬP TOA THUỐC\n\nskinparam shadowing false\nskinparam defaultFontSize 12\nskinparam activity {\n  BackgroundColor white\n  BorderColor black\n  DiamondBackgroundColor white\n  DiamondBorderColor black\n}\nskinparam ArrowColor black\n\n|Bệnh nhân|\nstart\n:Đến đăng ký khám bệnh;\n\n|Nhân viên tiếp nhận|\n:Tra cứu thông tin bệnh nhân;\n\nif (Đã có hồ sơ bệnh án?) then (Có)\n  :Tra cứu và mở hồ sơ hiện có;\nelse (Chưa)\n  :Nhập thông tin đăng ký;\n  :Ghi nhận phí đăng ký hằng năm;\n  if (Đã hoàn tất phí đăng ký?) then (Có)\n    :Tạo hồ sơ bệnh án;\n    :Cấp mã hồ sơ;\n  else (Chưa)\n    :Thông báo chưa đủ điều kiện;\n    stop\n  endif\nendif\n\n:Lập phiếu khám;\n\n|Bác sĩ|\n:Tiếp nhận phiếu khám;\n:Xem lịch sử bệnh án khi cần;\n:Khám và ghi nhận triệu chứng;\n\nif (Có cần xét nghiệm?) then (Có)\n  :Lập chỉ định xét nghiệm;\n\n  |Nhân viên xét nghiệm|\n  :Tiếp nhận chỉ định;\n  :Thực hiện xét nghiệm;\n  :Cập nhật kết quả xét nghiệm;\n\n  |Bác sĩ|\n  :Xem và đánh giá kết quả;\nelse (Không)\n  :Đánh giá tình trạng bệnh;\nendif\n\n:Lập toa thuốc;\n:Xác nhận toa thuốc;\n\n|Bệnh nhân|\n:Nhận toa thuốc;\nstop\n\n@enduml\n\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="tgmEXfvFNNIJ0Vp-Fyiw-431">
