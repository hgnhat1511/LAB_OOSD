        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntop to bottom direction\nskinparam classAttributeIconSize 0\nskinparam shadowing false\nskinparam linetype ortho\nskinparam packageStyle rectangle\nskinparam defaultFontSize 12\n\npackage \&quot;QUẢN LÝ BỆNH NHÂN\&quot; {\n  class BenhNhan {\n    maBenhNhan : String &lt;&lt;PK&gt;&gt;\n    hoTen : String\n    diaChi : String\n    ngaySinh : Date\n    soDienThoai : String\n    anh3x4 : String\n    +dangKy()\n    +capNhatThongTin()\n  }\n\n  class PhieuDangKy {\n    maPhieuDangKy : String &lt;&lt;PK&gt;&gt;\n    maBenhNhan : String &lt;&lt;FK&gt;&gt;\n    ngayDangKy : Date\n    soTienPhaiNop : Decimal\n    trangThaiPhi : String\n    +ghiNhanDangKy()\n    +capNhatTrangThaiPhi()\n  }\n\n  class HoSoBenhAn {\n    maHoSo : String &lt;&lt;PK&gt;&gt;\n    maBenhNhan : String &lt;&lt;FK&gt;&gt;\n    ngayLap : Date\n    trangThai : String\n    +taoHoSo()\n    +traCuuHoSo()\n  }\n\n  class LichKhamDinhKy {\n    maLichKham : String &lt;&lt;PK&gt;&gt;\n    maHoSo : String &lt;&lt;FK&gt;&gt;\n    ngayHen : Date\n    gioHen : Time\n    trangThai : String\n    +datLich()\n    +capNhatLich()\n  }\n}\n\npackage \&quot;NHÂN SỰ\&quot; {\n  class NhanVien {\n    maNhanVien : String &lt;&lt;PK&gt;&gt;\n    hoTen : String\n    soDienThoai : String\n    vaiTro : String\n    trangThai : String\n    +capNhatThongTin()\n  }\n\n  class BacSi {\n    maKhoa : String &lt;&lt;FK&gt;&gt;\n    chuyenMon : String\n    +khamBenh()\n    +lapToaThuoc()\n    +chiDinhXetNghiem()\n  }\n  \n  &#39; Bác sĩ kế thừa từ Nhân Viên\n  BacSi --|&gt; NhanVien \n}\n\npackage \&quot;KHÁM CHỮA BỆNH\&quot; {\n  class Khoa {\n    maKhoa : String &lt;&lt;PK&gt;&gt;\n    tenKhoa : String\n    moTa : String\n  }\n\n  class PhieuKham {\n    maPhieuKham : String &lt;&lt;PK&gt;&gt;\n    maHoSo : String &lt;&lt;FK&gt;&gt;\n    maNhanVien_BacSi : String &lt;&lt;FK&gt;&gt;\n    maKhoa : String &lt;&lt;FK&gt;&gt;\n    maLichKham : String &lt;&lt;FK, optional&gt;&gt;\n    ngayGioKham : DateTime\n    trieuChung : String\n    nhietDo : Decimal\n    huyetAp : String\n    loaiKham : String\n    +taoPhieuKham()\n    +capNhatThongTinKham()\n  }\n\n  class ToaThuoc {\n    maToaThuoc : String &lt;&lt;PK&gt;&gt;\n    maPhieuKham : String &lt;&lt;FK&gt;&gt;\n    ngayLap : Date\n    ghiChu : String\n    +lapToaThuoc()\n    +xacNhanToaThuoc()\n  }\n\n  class Thuoc {\n    maThuoc : String &lt;&lt;PK&gt;&gt;\n    tenThuoc : String\n    donViTinh : String\n    donGia : Decimal\n    soLuongTon : Integer\n  }\n\n  class ChiTietToaThuoc {\n    maChiTiet : String &lt;&lt;PK&gt;&gt;\n    maToaThuoc : String &lt;&lt;FK&gt;&gt;\n    maThuoc : String &lt;&lt;FK&gt;&gt;\n    lieuDung : String\n    cachDung : String\n    soLuong : Integer\n    thoiGianDung : String\n  }\n\n  class DichVuXetNghiem {\n    maDichVu : String &lt;&lt;PK&gt;&gt;\n    tenDichVu : String\n    donGia : Decimal\n  }\n\n  class XetNghiem {\n    maXetNghiem : String &lt;&lt;PK&gt;&gt;\n    maPhieuKham : String &lt;&lt;FK&gt;&gt;\n    maDichVu : String &lt;&lt;FK&gt;&gt;\n    ngayChiDinh : Date\n    ketQua : String\n    trangThai : String\n    +taoChiDinh()\n    +capNhatKetQua()\n  }\n}\n\npackage \&quot;THANH TOÁN VÀ THEO DÕI\&quot; {\n  class ThanhToan {\n    maThanhToan : String &lt;&lt;PK&gt;&gt;\n    maPhieuDangKy : String &lt;&lt;FK, optional&gt;&gt;\n    maPhieuKham : String &lt;&lt;FK, optional&gt;&gt;\n    loaiThanhToan : String\n    soTien : Decimal\n    ngayThanhToan : Date\n    hinhThuc : String\n    trangThai : String\n    +ghiNhanThanhToan()\n  }\n\n  class TheoDoiSauDieuTri {\n    maTheoDoi : String &lt;&lt;PK&gt;&gt;\n    maPhieuKham : String &lt;&lt;FK&gt;&gt;\n    maNhanVien : String &lt;&lt;FK&gt;&gt;\n    ngayGhiNhan : Date\n    dienBienBenh : String\n    tacDungPhu : String\n    hieuQuaDieuTri : String\n    +ghiNhanTheoDoi()\n  }\n}\n\n&#39; Quan hệ quản lý bệnh nhân\nBenhNhan \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuDangKy : đăng ký\nBenhNhan \&quot;1\&quot; -- \&quot;1\&quot; HoSoBenhAn : sở hữu\nHoSoBenhAn \&quot;1\&quot; -- \&quot;0..*\&quot; LichKhamDinhKy : có lịch hẹn\nHoSoBenhAn \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKham : có lịch sử khám\n\n&#39; Quan hệ khám chữa bệnh\nKhoa \&quot;1\&quot; -- \&quot;0..*\&quot; BacSi : quản lý\nKhoa \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKham : tiếp nhận\nBacSi \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKham : phụ trách\nPhieuKham \&quot;1\&quot; -- \&quot;0..1\&quot; ToaThuoc : lập\nToaThuoc \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietToaThuoc : gồm\nChiTietToaThuoc \&quot;0..*\&quot; -- \&quot;1\&quot; Thuoc : tham chiếu\nPhieuKham \&quot;1\&quot; -- \&quot;0..*\&quot; XetNghiem : có chỉ định\nXetNghiem \&quot;0..*\&quot; -- \&quot;1\&quot; DichVuXetNghiem : thuộc loại\nLichKhamDinhKy \&quot;0..1\&quot; -- \&quot;0..1\&quot; PhieuKham : ghi nhận\n\n&#39; Quan hệ thanh toán\nPhieuDangKy \&quot;0..1\&quot; -- \&quot;0..*\&quot; ThanhToan : phí đăng ký\nPhieuKham \&quot;0..1\&quot; -- \&quot;0..*\&quot; ThanhToan : viện phí\n\n&#39; Quan hệ theo dõi sau điều trị\nPhieuKham \&quot;1\&quot; -- \&quot;0..*\&quot; TheoDoiSauDieuTri : được theo dõi\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; TheoDoiSauDieuTri : ghi nhận\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="3x15dybqRc1lO97w26sW-218">
