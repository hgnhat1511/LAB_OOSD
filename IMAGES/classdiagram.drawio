  <diagram name="Trang-1" id="IJSVzNjj9DoMceukU6LP">
    <mxGraphModel dx="1493" dy="822" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle SƠ ĐỒ LỚP CHI TIẾT - HỆ THỐNG CIV-05\n\ntop to bottom direction\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam linetype ortho\nskinparam classAttributeIconSize 0\nskinparam defaultFontName Arial\nskinparam defaultFontSize 12\nskinparam nodesep 35\nskinparam ranksep 45\nhide circle\n\nskinparam class {\n  BackgroundColor white\n  BorderColor #555555\n  ArrowColor #333333\n}\n\n&#39;========================\n&#39; 1. NHOM NGUOI DUNG\n&#39;========================\nclass NguoiDung {\n  maTaiKhoan: String\n  tenDangNhap: String\n  matKhau: String\n  email: String\n  soDienThoai: String\n  vaiTro: String\n  trangThai: Boolean\n  --\n  dangNhap(): Boolean\n  dangXuat(): void\n  doiMatKhau(): void\n}\n\nclass CuDan {\n  maCuDan: String\n  hoTen: String\n  diaChi: String\n  --\n  dangKyPhuongTien(): void\n  xemGiayPhep(): void\n  xemViPham(): void\n}\n\nclass BanQuanLy {\n  maNhanVien: String\n  hoTen: String\n  chucVu: String\n  --\n  thietLapHanNgach(): void\n  xetDuyetGiayPhep(): void\n  xuLyViPham(): void\n  xuatBaoCao(): void\n}\n\nclass BaoVe {\n  maBaoVe: String\n  hoTen: String\n  caTruc: String\n  --\n  traCuuPhuongTien(): void\n  ghiNhanVaoRa(): void\n  lapBienBan(): void\n}\n\n&#39;========================\n&#39; 2. NHOM QUAN LY XE\n&#39;========================\nclass CanHo {\n  maCanHo: String\n  toaNha: String\n  chuHo: String\n  soDienThoai: String\n  hanNgachOto: int\n  hanNgachXeMay: int\n  --\n  kiemTraHanNgach(): Boolean\n  capNhatHanNgach(): void\n}\n\nclass PhuongTien {\n  bienSo: String\n  loaiXe: String\n  nhanHieu: String\n  mauSon: String\n  anhGiayTo: String\n  trangThaiDuyet: String\n  --\n  capNhatThongTin(): void\n  layThongTin(): void\n}\n\nclass KhuVucDo {\n  maKhuVuc: String\n  tenKhuVuc: String\n  loaiXeChoPhep: String\n  sucChuaToiDa: int\n  sucChuaHienTai: int\n  --\n  kiemTraChoTrong(): Boolean\n  capNhatSucChua(): void\n}\n\nclass GiayPhepDoXe {\n  maGiayPhep: String\n  ngayCap: Date\n  hanSuDung: Date\n  trangThai: String\n  --\n  kiemTraHopLe(): Boolean\n  khoaGiayPhep(): void\n}\n\n&#39;========================\n&#39; 3. NHOM THEO DOI HOAT DONG\n&#39;========================\nclass LichSuRaVao {\n  maGiaoDich: String\n  thoiGian: DateTime\n  congRaVao: String\n  loaiGiaoDich: String\n  hinhAnhCamera: String\n  --\n  ghiNhan(): void\n}\n\nclass ViPham {\n  maViPham: String\n  thoiGian: DateTime\n  loaiLoi: String\n  hinhAnh: String\n  tienPhat: decimal\n  trangThai: String\n  --\n  lapBienBan(): void\n  capNhatXuLy(): void\n}\n\n&#39;========================\n&#39; 4. KE THUA\n&#39;========================\nNguoiDung &lt;|-- CuDan\nNguoiDung &lt;|-- BanQuanLy\nNguoiDung &lt;|-- BaoVe\n\n&#39;========================\n&#39; 5. CAC QUAN HE NGHIEP VU\n&#39;========================\nCanHo \&quot;1\&quot; -- \&quot;0..*\&quot; CuDan : chứa\nCanHo \&quot;1\&quot; -- \&quot;0..*\&quot; PhuongTien : quản lý\nCuDan \&quot;1\&quot; -- \&quot;0..*\&quot; PhuongTien : sở hữu\n\nPhuongTien \&quot;1\&quot; -- \&quot;0..1\&quot; GiayPhepDoXe : được cấp\nKhuVucDo \&quot;1\&quot; -- \&quot;0..*\&quot; GiayPhepDoXe : áp dụng\n\nPhuongTien \&quot;1\&quot; -- \&quot;0..*\&quot; LichSuRaVao : ghi nhận\nBaoVe \&quot;1\&quot; -- \&quot;0..*\&quot; LichSuRaVao : kiểm soát\n\nPhuongTien \&quot;1\&quot; -- \&quot;0..*\&quot; ViPham : phát sinh\nBaoVe \&quot;1\&quot; -- \&quot;0..*\&quot; ViPham : lập biên bản\nBanQuanLy \&quot;1\&quot; -- \&quot;0..*\&quot; ViPham : xử lý\n\n&#39; Gợi ý bố cục\nNguoiDung -[hidden]right- CanHo\nBanQuanLy -[hidden]right- CuDan\nCuDan -[hidden]down- PhuongTien\nPhuongTien -[hidden]right- KhuVucDo\nLichSuRaVao -[hidden]right- ViPham\nViPham -[hidden]right- GiayPhepDoXe\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="qAeaa-ZNa4ySb_5jnJn5-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
