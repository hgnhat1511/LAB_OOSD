@startuml SD_Design_PhieuChi
skinparam shadowing false
actor "Kế toán" as KT
participant "FrmPhieuChi" as F
database "SQL Server" as DB
 
KT -> F : mở Form
F -> DB : SELECT quyết định khen thưởng WHERE TrangThai = N'Đã ký'
DB --> F : danh sách
KT -> F : chọn quyết định, nhập ngày chi; btnLuu_Click()
F -> DB : BEGIN TRANSACTION
F -> DB : 1) INSERT PhieuChiKhenThuong (SoTien = SoTienThuong của quyết định)
F -> DB : 2) UPDATE QuyetDinhKhenThuong SET TrangThai = N'Đã chi'
alt thành công
  F -> DB : COMMIT
  F --> KT : "Đã lập phiếu chi"
else lỗi (trigger, khóa ngoại, UNIQUE)
  F -> DB : ROLLBACK (bắt lỗi nếu trigger đã rollback)
  F --> KT : MessageBox lỗi
end
@enduml