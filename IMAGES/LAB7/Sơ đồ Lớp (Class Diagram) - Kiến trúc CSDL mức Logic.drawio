        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\nhide empty methods\n\nclass \&quot;NhanVien\&quot; as NhanVien {\n  MaNV {id}\n  HoTen\n  NgaySinh\n  GioiTinh\n  DiaChi\n  SoDienThoai\n  CCCD\n  TrangThai\n  --\n  taoHoSo()\n  capNhat()\n  timKiem()\n  doiTrangThai()\n}\n\nclass \&quot;PhongBan\&quot; as PhongBan {\n  MaPB {id}\n  TenPB\n  --\n  capNhat()\n}\n\nclass \&quot;ChucVu\&quot; as ChucVu {\n  MaCV {id}\n  TenCV\n  --\n  capNhat()\n}\n\nclass \&quot;QuyetDinhTuyenDung\&quot; as QuyenDinhTuyenDung {\n  SoQD {id}\n  NgayLap\n  NgayBatDauThuViec\n  NgayKetThucThuViec\n  LuongThuViec\n  DieuKhoanCongTy\n  DieuKhoanNguoiLaoDong\n  --\n  lap()\n  daHetThuViec()\n}\n\nclass \&quot;HopDong\&quot; as HopDong {\n  SoHD {id}\n  LoaiHD\n  NgayKy\n  NgayBatDau\n  NgayKetThuc\n  --\n  lap()\n  laDaiHan()\n}\n\nclass \&quot;QuyetDinhChucVu\&quot; as QuyetDinhChucVu {\n  SoQD {id}\n  NgayHieuLuc\n  PhuCapChucVu\n  --\n  lap()\n}\n\nclass \&quot;QuyetDinhLuong\&quot; as QuyetDinhLuong {\n  SoQD {id}\n  NgayHieuLuc\n  LuongCoBan\n  PhuCapLuong\n  PhuCapDocHai\n  --\n  lap()\n}\n\nclass \&quot;HoSoBaoHiem\&quot; as HoSoBaoHiem {\n  MaHS {id}\n  SoSoBHXH\n  SoTheBHYT\n  NgayLap\n  TyLeDongBHXH\n  TyLeDongBHYT\n  --\n  lap()\n  tinhTienBaoHiem()\n}\n\nclass \&quot;BangLuong\&quot; as BangLuong {\n  MaBL {id}\n  Thang\n  Nam\n  NgayLap\n  SoNgayCongChuan\n  SoGioMotNgay\n  HeSoPhuTroi\n  --\n  tinhLuong()\n  xoa()\n}\n\nclass \&quot;ChiTietBangLuong\&quot; as ChiTietBangLuong {\n  LuongCoBan\n  PhuCapChucVu\n  PhuCapLuong\n  PhuCapDocHai\n  SoNgayCong\n  LuongTheoNgayCong\n  TongGioPhuTroi\n  DonGiaGio\n  TienPhuTroi\n  TienBaoHiem\n  TienPhat\n  ThucLinh\n  --\n  tinhThucLinh()\n}\n\nclass \&quot;KeHoachPhanCong\&quot; as KeHoachPhanCong {\n  MaKH {id}\n  TuNgay\n  DenNgay\n  NgayLap\n  --\n  lap()\n}\n\nclass \&quot;ChiTietPhanCong\&quot; as ChiTietPhanCong {\n  NgayLam {id}\n  CoPhuTroi\n}\n\nclass \&quot;CaLamViec\&quot; as CaLamViec {\n  MaCa {id}\n  TenCa\n  GioBatDau\n  GioKetThuc\n  --\n  capNhat()\n}\n\nclass \&quot;PhieuChamCong\&quot; as PhieuChamCong {\n  SoPhieu {id}\n  NgayLap\n  --\n  lap()\n}\n\nclass \&quot;ChiTietChamCong\&quot; as ChiTietChamCong {\n  DiLam\n}\n\nclass \&quot;PhieuPhuTroi\&quot; as PhieuPhuTroi {\n  SoPhieu {id}\n  NgayPhuTroi\n  HinhThuc\n  --\n  lap()\n  tongGioPhuTroi()\n}\n\nclass \&quot;ChiTietPhuTroi\&quot; as ChiTietPhuTroi {\n  SoGioPhuTroi\n}\n\nclass \&quot;QuyetDinhKhenThuong\&quot; as QuyetDinhKhenThuong {\n  SoQD {id}\n  NgayLap\n  LoaiKhenThuong\n  DoiTuong\n  LyDo\n  SoTienThuong\n  TrangThai\n  NgayKy\n  --\n  lap()\n  ky()\n}\n\nclass \&quot;PhieuChiKhenThuong\&quot; as PhieuChiKhenThuong {\n  SoPhieu {id}\n  NgayChi\n  SoTien\n  --\n  lap()\n}\n\nclass \&quot;QuyetDinhKyLuat\&quot; as QuyetDinhKyLuat {\n  SoQD {id}\n  NgayLap\n  DoiTuong\n  LyDo\n  SoTienPhat\n  HinhThucThu\n  TrangThai\n  --\n  lap()\n  danhDauDaXuLy()\n}\n\nclass \&quot;PhieuThuNopPhat\&quot; as PhieuThuNopPhat {\n  SoPhieu {id}\n  NgayThu\n  SoTien\n  --\n  lap()\n}\n\nNhanVien \&quot;0..1\&quot; -- \&quot;1\&quot; PhongBan : thuộc\nNhanVien \&quot;1\&quot; -- \&quot;0..1\&quot; QuyenDinhTuyenDung : lập thẻ\nNhanVien \&quot;1\&quot; -- \&quot;0..1\&quot; HopDong : lập thẻ\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhChucVu : lập thẻ\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhLuong : lập thẻ\nNhanVien \&quot;1\&quot; -- \&quot;0..1\&quot; HoSoBaoHiem : lập thẻ\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhKhenThuong : nhận\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhKyLuat : nhận\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietBangLuong : nhận\nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; KeHoachPhanCong : phòng ban lập KH\nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhKhenThuong : nhận\nChucVu \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhChucVu : quy định\n