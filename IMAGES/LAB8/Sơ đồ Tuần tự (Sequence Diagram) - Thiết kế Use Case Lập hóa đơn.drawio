        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\nautonumber\n\nactor \&quot;Nhân viên\&quot; as NV\nparticipant \&quot;FrmHoaDon\&quot; as GUI\nparticipant \&quot;FrmPhieuHenGiao\&quot; as FrmHen\ndatabase \&quot;SQL Server\&quot; as DB\n\nNV -&gt; GUI : chọn khách hàng, thêm mặt hàng và số lượng\nactivate GUI\n\nGUI -&gt; DB : SELECT SoLuongTon của từng mặt hàng\nactivate DB\nDB --&gt; GUI : tồn kho\ndeactivate DB\n\nalt tồn kho đủ\n    GUI -&gt; GUI : SoLuongGiaoNgay = SoLuong\nelse thiếu và khách quen\n    GUI -&gt; GUI : SoLuongGiaoNgay = tồn hiện có\nelse thiếu và vãng lai\n    GUI --&gt; NV : chỉ bán phần có sẵn, chờ xác nhận\nend\n\nNV -&gt; GUI : btnLuu_Click\n\nGUI -&gt; DB : BEGIN TRANSACTION\nactivate DB\nGUI -&gt; DB : 1) INSERT HoaDon\nGUI -&gt; DB : 2) INSERT ChiTietHoaDon (SoLuong, SoLuongDaGiao = SoLuongGiaoNgay)\nGUI -&gt; DB : 3) UPDATE NuocGiaiKhat SET SoLuongTon = SoLuongTon - SoLuongGiaoNgay\n\nalt thành công\n    DB --&gt; GUI : COMMIT\n    GUI --&gt; NV : Đã lập hóa đơn\n    \n    opt còn hàng chưa giao và khách quen\n        GUI -&gt; FrmHen : mở Form lập phiếu hẹn cho hóa đơn\n        activate FrmHen\n        FrmHen --&gt; GUI\n        deactivate FrmHen\n    end\nelse lỗi (CHECK tồn kho không âm, khóa ngoại)\n    DB --&gt; GUI : ROLLBACK\n    deactivate DB\n    GUI --&gt; NV : MessageBox lỗi\nend\n\ndeactivate GUI\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="6osUjpCT5uemQ9Bsrq9W-1">
