        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\nhide empty methods\n\nclass \&quot;NhaCungUng\&quot; as NhaCungUng {\n  MaNCU [id]\n  TenNCU\n  DiaChi\n  SoDienThoai\n  --\n  +capNhat()\n  +timKiem()\n}\n\nclass \&quot;NhanVien\&quot; as NhanVien {\n  MaNV [id]\n  HoTen\n  SoDienThoai\n  DiaChi\n  --\n  +capNhat()\n  +timKiem()\n}\n\nclass \&quot;LoaiNGK\&quot; as LoaiNGK {\n  MaLoai [id]\n  TenLoai\n  MaNCU\n  --\n  +capNhat()\n  +timKiem()\n}\n\nclass \&quot;DonDatHang\&quot; as DonDatHang {\n  SoDDH [id]\n  NgayDat\n  NgayNhan\n  TrangThai\n  MaNCU\n  MaNV\n  --\n  +lap()\n  +demSoDotGiao()\n  +daNhanDu()\n}\n\nclass \&quot;NuocGiaiKhat\&quot; as NuocGiaiKhat {\n  MaNGK [id]\n  TenNGK\n  DonViTinh\n  DonGiaBan\n  SoLuongTon\n  MaLoai\n  --\n  +kiemTraTon(sl)\n  +tangTon(sl)\n  +giamTon(sl)\n  +capNhat()\n}\n\nclass \&quot;PhieuGiaoHang\&quot; as PhieuGiaoHang {\n  SoPGH [id]\n  SoDDH\n  DotGiao\n  NgayGiao\n  TongTien\n  --\n  +lap()\n  +tinhTongTien()\n}\n\nclass \&quot;ChiTietDDH\&quot; as ChiTietDDH {\n  SoDDH [id]\n  MaNGK [id]\n  SoLuongDat\n  --\n  +tinhSoLuongConThieu()\n}\n\nclass \&quot;ChiTietPGH\&quot; as ChiTietPGH {\n  SoPGH [id]\n  MaNGK [id]\n  SoLuongGiao\n  DonGiaNhap\n  --\n  +thanhTien()\n}\n\nNhaCungUng \&quot;1\&quot; -- \&quot;1..*\&quot; LoaiNGK : cung ứng\nNhaCungUng \&quot;1\&quot; -- \&quot;0..*\&quot; DonDatHang : nhận\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; DonDatHang : lập\nLoaiNGK \&quot;1\&quot; -- \&quot;1..*\&quot; NuocGiaiKhat : gồm\nDonDatHang \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietDDH : gồm\nDonDatHang \&quot;1\&quot; -- \&quot;0..3\&quot; PhieuGiaoHang : giao theo đợt\nNuocGiaiKhat \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietDDH : được đặt\nNuocGiaiKhat \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPGH : được giao\nPhieuGiaoHang \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPGH : gồm\nChiTietDDH \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPGH\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="omaFc_lHmSWMIJeOiFTG-1">
