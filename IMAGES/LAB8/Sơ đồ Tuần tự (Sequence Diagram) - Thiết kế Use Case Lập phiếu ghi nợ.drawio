  <diagram name="Trang-1" id="ZOImSDSZB4GeVATRD9Bw">
    <mxGraphModel dx="1030" dy="567" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\nautonumber\n\nactor \&quot;Nhân viên\&quot; as NV\nparticipant \&quot;Giao diện lập phiếu ghi nợ\&quot; as GUI\nparticipant \&quot;:HoaDon\&quot; as HD\nparticipant \&quot;:KhachHang\&quot; as KH\nparticipant \&quot;:PhieuGhiNo\&quot; as PGN\ndatabase \&quot;SQL Server\&quot; as DB\n\nNV -&gt; GUI : chọn chức năng Lập phiếu ghi nợ, nhập số hóa đơn\nactivate GUI\n\nGUI -&gt; DB : SELECT hóa đơn, khách hàng JOIN LoaiKhach, tiền đã thanh toán\nactivate DB\nDB --&gt; GUI : thông tin hóa đơn, khách hàng\ndeactivate DB\n\nGUI -&gt; HD : layThongTin(soHD)\nactivate HD\nHD --&gt; GUI : khách hàng, tổng tiền, số tiền đã thanh toán\ndeactivate HD\n\nGUI -&gt; KH : laKhachQuen()\nactivate KH\nKH --&gt; GUI : true / false\ndeactivate KH\n\nalt không phải khách quen (LoaiKhach khác Khách quen)\n    GUI --&gt; NV : báo lỗi: khách vãng lai phải thanh toán ngay\\n(báo lỗi, không cho lập)\nelse là khách quen (Khách quen)\n    NV -&gt; GUI : nhập số tiền nợ, ngày dự kiến trả, lý do, btnLuu_Click\n    \n    GUI -&gt; GUI : kiểm tra 0 &lt; SoTienNo &lt;= tiền chưa thanh toán, ngày dự kiến trả &gt;= ngày lập\n    \n    alt dữ liệu không hợp lệ\n        GUI --&gt; NV : báo lỗi, yêu cầu nhập lại\n    else hợp lệ\n        GUI -&gt; PGN : lap(soHD, maKH, soTienNo, ngayDuKienTra, lyDo, maNV)\n        activate PGN\n        PGN --&gt; GUI : phiếu ghi nợ trạng thái Chưa trả\n        deactivate PGN\n        \n        GUI -&gt; DB : BEGIN TRANSACTION\n        activate DB\n        GUI -&gt; DB : INSERT PhieuGhiNo (TrangThai = Chưa trả)\n        \n        alt thành công\n            DB --&gt; GUI : COMMIT\n            GUI -&gt; KH : capNhatCongNo(soTienNo)\n            activate KH\n            KH --&gt; GUI\n            deactivate KH\n            \n            GUI --&gt; NV : thông báo lập phiếu thành công, in phiếu\\n(Đã lập phiếu ghi nợ)\n        else lỗi CHECK, khóa ngoại, trigger\n            DB --&gt; GUI : ROLLBACK\n            deactivate DB\n            GUI --&gt; NV : MessageBox lỗi\n        end\n    end\nend\ndeactivate GUI\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="hJHn4-3qNUzUwinGdgvI-1">
