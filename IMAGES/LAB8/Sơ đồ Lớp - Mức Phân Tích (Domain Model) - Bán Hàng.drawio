        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\nhide empty methods\n\nclass \&quot;KhachHang\&quot; as KhachHang {\n  MaKH [id]\n  HoTen\n  DiaChi\n  SoDienThoai\n  LoaiKhach\n  --\n  +laKhachQuen()\n  +tongNoConLai()\n  +capNhat()\n}\n\nclass \&quot;NhanVien\&quot; as NhanVien {\n  MaNV [id]\n  HoTen\n  SoDienThoai\n  DiaChi\n  --\n  +capNhat()\n  +timKiem()\n}\n\nclass \&quot;HoaDon\&quot; as HoaDon {\n  SoHD [id]\n  NgayLap\n  TongTien\n  TrangThai\n  MaKH\n  MaNV\n  --\n  +lap()\n  +tinhTongTien()\n  +daGiaoDu()\n}\n\nclass \&quot;PhieuGhiNo\&quot; as PhieuGhiNo {\n  SoPGN [id]\n  NgayLap\n  SoHD\n  MaKH\n  SoTienNo\n  NgayDuKienTra\n  LyDo\n  MaNV\n  TrangThai\n  --\n  +lap()\n  +kiemTraKhachQuen()\n  +danhDauDaTra()\n}\n\nclass \&quot;NuocGiaiKhat\&quot; as NuocGiaiKhat {\n  MaNGK [id]\n  TenNGK\n  DonViTinh\n  DonGiaBan\n  SoLuongTon\n  MaLoai\n  --\n  +kiemTraTon(sl)\n  +tangTon(sl)\n  +giamTon(sl)\n  +capNhat()\n}\n\nclass \&quot;PhieuHenGiao\&quot; as PhieuHenGiao {\n  SoPHG [id]\n  SoHD\n  NgayHen\n  TrangThai\n  --\n  +lap()\n  +giaoHang()\n}\n\nclass \&quot;ChiTietHoaDon\&quot; as ChiTietHoaDon {\n  SoHD [id]\n  MaNGK [id]\n  SoLuong\n  DonGia\n  SoLuongDaGiao\n  --\n  +thanhTien()\n  +soLuongConThieu()\n}\n\nclass \&quot;ChiTietPhieuHen\&quot; as ChiTietPhieuHen {\n  SoPHG [id]\n  MaNGK [id]\n  SoLuongHen\n  --\n  +kiemTraHopLe()\n}\n\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; HoaDon : mua\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuGhiNo : nợ\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; HoaDon : lập\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuGhiNo : lập\nHoaDon \&quot;1\&quot; -- \&quot;0..1\&quot; PhieuGhiNo : ghi nợ cho\nHoaDon \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuHenGiao : hẹn giao theo\nHoaDon \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietHoaDon : gồm\nPhieuHenGiao \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhieuHen : gồm\nNuocGiaiKhat \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietHoaDon : được bán\nNuocGiaiKhat \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhieuHen : được hẹn\nChiTietHoaDon \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhieuHen\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="5p1U2RGcXXBFrvsox3rB-1">
