        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\nclass NhaCungUng {\n  + maNCU : String &lt;&lt;PK&gt;&gt;\n  + tenNCU : String\n  + diaChi : String\n  + soDienThoai : String\n  + Them()\n  + Sua()\n  + Xoa()\n  + TraCuu()\n}\nclass NhanHieu {\n  + maLoai : String &lt;&lt;PK&gt;&gt;\n  + tenLoai : String\n  + Them()\n  + Sua()\n  + Xoa()\n}\nclass NhanVien {\n  + maNV : String &lt;&lt;PK&gt;&gt;\n  + tenNV : String\n  + chucVu : String\n  + Them()\n  + Sua()\n  + Xoa()\n}\nclass KhachHang {\n  + maKH : String &lt;&lt;PK&gt;&gt;\n  + tenKH : String\n  + soDienThoai : String\n  + loaiKhach : String\n  + Them()\n  + Sua()\n  + Xoa()\n  + PhanLoaiKhach()\n}\nclass DonDatHang {\n  + maDDH : String &lt;&lt;PK&gt;&gt;\n  + ngayDat : Date\n  + ngayNhan : Date\n  + trangThai : String\n  + maNCU : String &lt;&lt;FK&gt;&gt;\n  + maNV : String &lt;&lt;FK&gt;&gt;\n  + LapDon()\n  + InDon()\n  + CapNhatTrangThai()\n}\nclass NuocGiaiKhat {\n  + maNGK : String &lt;&lt;PK&gt;&gt;\n  + tenNGK : String\n  + donViTinh : String\n  + soLuongTon : int\n  + donGia : float\n  + maLoai : String &lt;&lt;FK&gt;&gt;\n  + Them()\n  + Sua()\n  + Xoa()\n  + CapNhatTonKho()\n}\nclass HoaDon {\n  + maHD : String &lt;&lt;PK&gt;&gt;\n  + ngayLap : Date\n  + tongTien : float\n  + maKH : String &lt;&lt;FK&gt;&gt;\n  + maNV : String &lt;&lt;FK&gt;&gt;\n  + LapHoaDon()\n  + TinhTien()\n  + InHoaDon()\n}\nclass PhieuGhiNo {\n  + maPGN : String &lt;&lt;PK&gt;&gt;\n  + ngayLap : Date\n  + soTienNo : float\n  + ngayDuKienTra : Date\n  + lyDoNo : String\n  + maKH : String &lt;&lt;FK&gt;&gt;\n  + maNV : String &lt;&lt;FK&gt;&gt;\n  + LapPhieuNo()\n  + CapNhatNo()\n}\nclass PhieuGiaoHang {\n  + maPGH : String &lt;&lt;PK&gt;&gt;\n  + ngayGiao : Date\n  + dotGiaoThu : int\n  + tongTienTra : float\n  + maDDH : String &lt;&lt;FK&gt;&gt;\n  + LapPhieu()\n  + TinhTongTien()\n}\nclass ChiTietDDH {\n  + maDDH : String &lt;&lt;PK, FK&gt;&gt;\n  + maNGK : String &lt;&lt;PK, FK&gt;&gt;\n  + soLuongDat : int\n  + ThemChiTiet()\n}\nclass ChiTietPGH {\n  + maPGH : String &lt;&lt;PK, FK&gt;&gt;\n  + maNGK : String &lt;&lt;PK, FK&gt;&gt;\n  + soLuongGiao : int\n  + thanhTien : float\n  + ThemChiTiet()\n}\nclass ChiTietHD {\n  + maHD : String &lt;&lt;PK, FK&gt;&gt;\n  + maNGK : String &lt;&lt;PK, FK&gt;&gt;\n  + soLuongMua : int\n  + donGia : float\n  + ThemChiTiet()\n}\nclass PhieuHen {\n  + maPH : String &lt;&lt;PK&gt;&gt;\n  + ngayLap : Date\n  + ngayHenGiao : Date\n  + maHD : String &lt;&lt;FK&gt;&gt;\n  + LapPhieuHen()\n  + CapNhatTrangThai()\n}\nclass ChiTietPH {\n  + maPH : String &lt;&lt;PK, FK&gt;&gt;\n  + maNGK : String &lt;&lt;PK, FK&gt;&gt;\n  + soLuongHen : int\n  + ThemChiTiet()\n}\n\nNhaCungUng \&quot;1\&quot; -- \&quot;*\&quot; DonDatHang\nNhanHieu \&quot;1\&quot; -- \&quot;*\&quot; NuocGiaiKhat\nNhanVien \&quot;1\&quot; -- \&quot;*\&quot; DonDatHang\nNhanVien \&quot;1\&quot; -- \&quot;*\&quot; HoaDon\nNhanVien \&quot;1\&quot; -- \&quot;*\&quot; PhieuGhiNo\nKhachHang \&quot;1\&quot; -- \&quot;*\&quot; HoaDon\nKhachHang \&quot;1\&quot; -- \&quot;*\&quot; PhieuGhiNo\nDonDatHang \&quot;1\&quot; *-- \&quot;1..3\&quot; PhieuGiaoHang\nDonDatHang \&quot;1\&quot; *-- \&quot;*\&quot; ChiTietDDH\nNuocGiaiKhat \&quot;1\&quot; -- \&quot;*\&quot; ChiTietDDH\nNuocGiaiKhat \&quot;1\&quot; -- \&quot;*\&quot; ChiTietPGH\nNuocGiaiKhat \&quot;1\&quot; -- \&quot;*\&quot; ChiTietHD\nNuocGiaiKhat \&quot;1\&quot; -- \&quot;*\&quot; ChiTietPH\nHoaDon \&quot;1\&quot; *-- \&quot;*\&quot; ChiTietHD\nHoaDon \&quot;1\&quot; -- \&quot;*\&quot; PhieuHen\nPhieuGiaoHang \&quot;1\&quot; *-- \&quot;*\&quot; ChiTietPGH\nPhieuHen \&quot;1\&quot; *-- \&quot;*\&quot; ChiTietPH\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="pibXmNcXE4ZpmqFA2Mjl-1">
