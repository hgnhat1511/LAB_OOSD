        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle MÔ HÌNH LỚP - HỆ THỐNG CIV-05\n\ntop to bottom direction\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam linetype ortho\nskinparam classAttributeIconSize 0\nskinparam packageStyle rectangle\nskinparam defaultFontName Arial\nskinparam class {\n  BackgroundColor #F5FAFF\n  BorderColor #3267A8\n  ArrowColor #3267A8\n}\n\npackage \&quot;Nhóm người dùng\&quot; {\n  class NguoiDung {\n    maTaiKhoan: String\n    tenDangNhap: String\n    matKhau: String\n    email: String\n    soDienThoai: String\n    vaiTro: String\n    trangThai: Boolean\n    --\n    dangNhap(): Boolean\n    dangXuat(): void\n    doiMatKhau(): void\n  }\n\n  class CuDan {\n    maCuDan: String\n    hoTen: String\n    diaChi: String\n    --\n    dangKyPhuongTien(): void\n    xemGiayPhep(): void\n    xemViPham(): void\n  }\n\n  class BanQuanLy {\n    maNhanVien: String\n    hoTen: String\n    chucVu: String\n    --\n    thietLapHanNgach(): void\n    xetDuyetGiayPhep(): void\n    xuLyViPham(): void\n    xuatBaoCao(): void\n  }\n\n  class BaoVe {\n    maBaoVe: String\n    hoTen: String\n    caTruc: String\n    --\n    traCuuPhuongTien(): void\n    ghiNhanVaoRa(): void\n    lapBienBan(): void\n  }\n}\n\npackage \&quot;Nhóm quản lý phương tiện\&quot; {\n  class CanHo {\n    maCanHo: String\n    toaNha: String\n    chuHo: String\n    soDienThoai: String\n    hanNgachOto: int\n    hanNgachXeMay: int\n    --\n    kiemTraHanNgach(): Boolean\n    capNhatHanNgach(): void\n  }\n\n  class PhuongTien {\n    maPhuongTien: String\n    bienSo: String\n    loaiXe: String\n    nhanHieu: String\n    mauSon: String\n    anhGiayTo: String\n    trangThaiDuyet: String\n    --\n    capNhatThongTin(): void\n    layThongTin(): void\n  }\n\n  class GiayPhepDoXe {\n    maGiayPhep: String\n    ngayCap: Date\n    hanSuDung: Date\n    trangThai: String\n    --\n    kiemTraHopLe(): Boolean\n    khoaGiayPhep(): void\n  }\n\n  class KhuVucDo {\n    maKhuVuc: String\n    tenKhuVuc: String\n    loaiXeChoPhep: String\n    sucChuaToiDa: int\n    sucChuaHienTai: int\n    --\n    kiemTraChoTrong(): Boolean\n    capNhatSucChua(): void\n  }\n}\n\npackage \&quot;Nhóm theo dõi hoạt động\&quot; {\n  class LichSuRaVao {\n    maGiaoDich: String\n    thoiGian: DateTime\n    congRaVao: String\n    loaiGiaoDich: String\n    hinhAnhCamera: String\n    --\n    ghiNhan(): void\n  }\n\n  class ViPham {\n    maViPham: String\n    thoiGian: DateTime\n    loaiLoi: String\n    hinhAnh: String\n    bienPhat: decimal\n    trangThai: String\n    --\n    lapBienBan(): void\n    capNhatXuLy(): void\n  }\n}\n\nNguoiDung &lt;|-- CuDan\nNguoiDung &lt;|-- BanQuanLy\nNguoiDung &lt;|-- BaoVe\n\nCanHo \&quot;1\&quot; -- \&quot;0..*\&quot; CuDan : cư trú\nCanHo \&quot;1\&quot; -- \&quot;0..*\&quot; PhuongTien : quản lý\nCuDan \&quot;1\&quot; -- \&quot;0..*\&quot; PhuongTien : sở hữu\nPhuongTien \&quot;1\&quot; -- \&quot;0..1\&quot; GiayPhepDoXe : được cấp\nKhuVucDo \&quot;1\&quot; -- \&quot;0..*\&quot; GiayPhepDoXe : áp dụng\nPhuongTien \&quot;1\&quot; -- \&quot;0..*\&quot; LichSuRaVao : ghi nhận\nBaoVe \&quot;1\&quot; -- \&quot;0..*\&quot; LichSuRaVao : kiểm soát\nPhuongTien \&quot;1\&quot; -- \&quot;0..*\&quot; ViPham : phát sinh\nBaoVe \&quot;1\&quot; -- \&quot;0..*\&quot; ViPham : lập biên bản\nBanQuanLy \&quot;1\&quot; -- \&quot;0..*\&quot; ViPham : xử lý\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="EcHpITwzM71QpLGqOYCM-44">
