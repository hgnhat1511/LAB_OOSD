        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\nhide circle\n\nclass \&quot;FrmDanhMuc\\n(from Giao dien)\&quot; as FrmDanhMuc &lt;&lt;boundary&gt;&gt; {\n  FrmDanhMuc_Load()\n  Tai()\n  btnThemKhu_Click()\n  btnThemNV_Click()\n  btnThemLoaiTN_Click()\n  btnThemDV_Click()\n  btnThemQD_Click()\n  btnDong_Click()\n}\n\nclass \&quot;DanhMucService\\n(from Dieu khien)\&quot; as DanhMucService &lt;&lt;control&gt;&gt; {\n  LayKhuVuc()\n  LayNhanVien()\n  LayLoaiTienNghi()\n  LayDichVu()\n  LayQuyDinhDenBu()\n  ThemKhu()\n  ThemNhanVien()\n  ThemLoaiTN()\n  ThemDichVu()\n  ThemQuyDinh()\n}\n\nclass \&quot;KhuVuc\\n(from Thuc the)\&quot; as KhuVuc {\n  MaKhuVuc : String\n  TenKhuVuc : String\n  --\n  themKhuVuc()\n  layDanhSach()\n}\n\nclass \&quot;NhanVien\\n(from Thuc the)\&quot; as NhanVien {\n  MaNV : String\n  HoTen : String\n  VaiTro : String\n  SoDienThoai : String\n  --\n  themNhanVien()\n  layDanhSach()\n}\n\nclass \&quot;LoaiTienNghi\\n(from Thuc the)\&quot; as LoaiTienNghi {\n  MaLoaiTN : String\n  TenLoaiTN : String\n  --\n  themLoaiTN()\n  layDanhSach()\n}\n\nclass \&quot;DichVu\\n(from Thuc the)\&quot; as DichVu {\n  MaDV : String\n  TenDV : String\n  DonViTinh : String\n  DonGia : Decimal\n  --\n  themDichVu()\n  layDanhSach()\n  layDonGia()\n}\n\nclass \&quot;QuyDinhDenBu\\n(from Thuc the)\&quot; as QuyDinhDenBu {\n  MaQuyDinh : String\n  MucDoThietHai : String\n  MucDenBu : Decimal\n  --\n  themQuyDinh()\n  layDanhSach()\n}\n\nFrmDanhMuc -right-&gt; DanhMucService\nDanhMucService -up-&gt; KhuVuc\nDanhMucService -right-&gt; NhanVien\nDanhMucService -right-&gt; LoaiTienNghi\nDanhMucService -down-&gt; DichVu\nDanhMucService -down-&gt; QuyDinhDenBu\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="0dtDZNOTXoVhZK8y7yBw-1">
