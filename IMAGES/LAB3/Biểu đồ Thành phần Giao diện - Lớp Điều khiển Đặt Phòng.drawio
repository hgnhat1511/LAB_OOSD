        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\nhide circle\n\nclass \&quot;FrmDatPhong\\n(from Giao dien)\&quot; as FrmDatPhong &lt;&lt;boundary&gt;&gt; {\n  Frm_Load()\n  Tai()\n  btnThemKhach_Click()\n  btnThemPhong_Click()\n  btnBoPhong_Click()\n  btnLapPhieu_Click()\n  dgvPhieu_SelectionChanged()\n  btnThemNguoi_Click()\n  btnNhanPhong_Click()\n  btnNoShow_Click()\n}\n\nclass \&quot;DatPhongService\\n(from Dieu khien)\&quot; as DatPhongService &lt;&lt;control&gt;&gt; {\n  LayKhach()\n  LayPhong()\n  LayPhieuDat()\n  LayChiTiet()\n  LayNguoiLuuTru()\n  ThemKhach()\n  PhongTrungLich()\n  TaoDatPhong()\n  ThemNguoiLuuTru()\n  NhanPhong()\n  DanhDauNoShow()\n}\n\nclass \&quot;KhachHang\\n(from Thuc the)\&quot; as KhachHang {\n  MaKhach : String\n  HoTen : String\n  SoCMND : String\n  QuocTich : String\n  SoDienThoai : String\n  --\n  themKhach()\n  layDanhSach()\n}\n\nclass \&quot;PhieuDatPhong\\n(from Thuc the)\&quot; as PhieuDatPhong {\n  SoPhieuDat : String\n  NgayLap : DateTime\n  NgayNhan : Date\n  NgayTraDuKien : Date\n  TienCoc : Decimal\n  KenhDat : String\n  TrangThai : String\n  NgayNhanThucTe : DateTime\n  NgayTraThucTe : DateTime\n  --\n  themPhieuDat()\n  layTrangThai()\n  capNhatTrangThai()\n  layPhieuDangO()\n  demPhieuDat()\n}\n\nclass \&quot;ChiTietDatPhong\\n(from Thuc the)\&quot; as ChiTietDatPhong {\n  SoNguoi : Integer\n  --\n  themChiTiet()\n  kiemTraTrungLich()\n  laySoNguoiDangKy()\n  layChiTiet()\n}\n\nclass \&quot;Phong\\n(from Thuc the)\&quot; as Phong {\n  SoPhong : String\n  SoNguoiToiDa : Integer\n  DonGiaNgay : Decimal\n  TrangThai : String\n  --\n  themPhong()\n  layDanhSach()\n  laySucChua()\n  capNhatTrangThai()\n}\n\nclass \&quot;NguoiLuuTru\\n(from Thuc the)\&quot; as NguoiLuuTru {\n  MaNguoiLT : Integer\n  HoTen : String\n  SoCMND : String\n  QuocTich : String\n  --\n  themNguoiLuuTru()\n  demNguoiLuuTru()\n  layDanhSach()\n}\n\nFrmDatPhong -right-&gt; DatPhongService\nDatPhongService -up-&gt; KhachHang\nDatPhongService -right-&gt; PhieuDatPhong\nDatPhongService -right-&gt; ChiTietDatPhong\nDatPhongService -down-&gt; Phong\nDatPhongService -down-&gt; NguoiLuuTru\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="v1XoTy_ci38RGIpJL3Uq-1">
