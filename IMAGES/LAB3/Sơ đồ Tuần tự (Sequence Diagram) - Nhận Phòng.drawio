        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\n\nactor \&quot;: NV le tan\&quot; as NV\nparticipant \&quot;: FrmDatPhong\&quot; as GUI\nparticipant \&quot;: DatPhongService\&quot; as BLL\nparticipant \&quot;: ChiTietDatPhong\&quot; as CT\nparticipant \&quot;: NguoiLuuTru\&quot; as NLT\nparticipant \&quot;: PhieuDatPhong\&quot; as Phieu\nparticipant \&quot;: Phong\&quot; as Phong\n\nNV -&gt; GUI : Chon phieu dat\nactivate GUI\nGUI -&gt; BLL : LayChiTiet(soPhieu)\nactivate BLL\nBLL -&gt; CT : layChiTiet(soPhieu)\nactivate CT\nCT --&gt; BLL : ds phong, so nguoi\ndeactivate CT\nBLL --&gt; GUI : ds phong\ndeactivate BLL\n\nNV -&gt; GUI : Nhap ho ten, CCCD, quoc tich nguoi luu tru\nGUI -&gt; BLL : ThemNguoiLuuTru(so, phong, ten, cccd, qt)\nactivate BLL\nBLL -&gt; CT : laySoNguoiDangKy(so, phong)\nactivate CT\nCT --&gt; BLL : SoNguoi\ndeactivate CT\n\nBLL -&gt; NLT : demNguoiLuuTru(so, phong)\nactivate NLT\nNLT --&gt; BLL : so nguoi da ghi\ndeactivate NLT\n\nopt so nguoi da ghi &lt; SoNguoi\n    BLL -&gt; NLT : themNguoiLuuTru(...)\n    activate NLT\n    NLT --&gt; BLL\n    deactivate NLT\nend\n\nBLL --&gt; GUI : KetQuaXuLy\ndeactivate BLL\n\nNV -&gt; GUI : Nhan \&quot;Nhan phong\&quot;\nGUI -&gt; BLL : NhanPhong(soPhieu, DateTime.Now)\nactivate BLL\nBLL -&gt; Phieu : capNhatTrangThai(\&quot;Dang o\&quot;, NgayNhanThucTe)\nactivate Phieu\nPhieu --&gt; BLL\ndeactivate Phieu\n\nBLL -&gt; Phong : capNhatTrangThai(\&quot;Dang o\&quot;)\nactivate Phong\nPhong --&gt; BLL\ndeactivate Phong\n\nBLL --&gt; GUI : KetQuaXuLy.Ok\ndeactivate BLL\nGUI --&gt; NV : Thong bao nhan phong thanh cong\ndeactivate GUI\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="c7IYITkj3UfIXnIxwZ9q-1">
