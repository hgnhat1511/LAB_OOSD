        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\n\nactor \&quot;: NV phuc vu\&quot; as NVPV\nactor \&quot;: NV thanh toan\&quot; as NVTT\nparticipant \&quot;: FrmTraPhong\&quot; as GUI\nparticipant \&quot;: TraPhongService\&quot; as BLL\nparticipant \&quot;: PhieuDenBu\&quot; as DenBu\nparticipant \&quot;: HoaDon\&quot; as HD\nparticipant \&quot;: ThanhToan\&quot; as TT\nparticipant \&quot;: PhieuDatPhong\&quot; as PhieuDat\nparticipant \&quot;: Phong\&quot; as Phong\n\nNVPV -&gt; GUI : Chon phieu dang o, chon phong\nactivate GUI\nGUI -&gt; BLL : LayTienNghiPhong(soPhong)\nactivate BLL\nBLL --&gt; GUI : ds tien nghi cua phong\ndeactivate BLL\n\nopt co tien nghi hu hong / mat\n    NVPV -&gt; GUI : Nhap muc do, so tien den bu\n    GUI -&gt; BLL : LapPhieuDenBu(soDB, soDat, phong, ngay, maNV, ds)\n    activate BLL\n    BLL -&gt; DenBu : themPhieuDenBu(), themChiTietDenBu()\n    activate DenBu\n    DenBu --&gt; BLL\n    deactivate DenBu\n    BLL --&gt; GUI : KetQuaXuLy\n    deactivate BLL\nend\n\nNVTT -&gt; GUI : Nhap so HD, so ngay tinh tien\nGUI -&gt; BLL : LapHoaDon(soHD, soDat, ngay, maNV, soNgay)\nactivate BLL\nBLL -&gt; BLL : Tinh TienPhong, TienDichVu\nBLL -&gt; HD : themHoaDon(..., \&quot;Chua thanh toan\&quot;)\nactivate HD\nHD --&gt; BLL\ndeactivate HD\nBLL --&gt; GUI\ndeactivate BLL\n\nNVTT -&gt; GUI : Chon hinh thuc, nhap so tien\nGUI -&gt; BLL : ThanhToan(maTT, soHD, ngay, hinhThuc, tien)\nactivate BLL\nBLL -&gt; TT : tongDaThanhToan(soHD)\nactivate TT\nTT --&gt; BLL : so tien da tra\ndeactivate TT\n\nBLL -&gt; TT : themGiaoDich(...)\nactivate TT\nTT --&gt; BLL\ndeactivate TT\n\nopt da tra + tien = TongTien\n    BLL -&gt; HD : capNhatTrangThai(\&quot;Da thanh toan\&quot;)\n    activate HD\n    HD --&gt; BLL\n    deactivate HD\nend\nBLL --&gt; GUI\ndeactivate BLL\n\nNVTT -&gt; GUI : Nhan \&quot;Hoan tat tra phong\&quot;\nGUI -&gt; BLL : TraPhong(soDat, ngayTra)\nactivate BLL\n\nBLL -&gt; HD : layTrangThai(soDat)\nactivate HD\nHD --&gt; BLL : \&quot;Da thanh toan\&quot;\ndeactivate HD\n\nBLL -&gt; PhieuDat : capNhatTrangThai(\&quot;Da tra\&quot;)\nactivate PhieuDat\nPhieuDat --&gt; BLL\ndeactivate PhieuDat\n\nBLL -&gt; Phong : capNhatTrangThai(\&quot;Trong\&quot;)\nactivate Phong\nPhong --&gt; BLL\ndeactivate Phong\n\nBLL --&gt; GUI : KetQuaXuLy.Ok\ndeactivate BLL\nGUI --&gt; NVTT : Thong bao hoan tat tra phong\ndeactivate GUI\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="V9B4kogdPT5MKxGHSx46-1">
