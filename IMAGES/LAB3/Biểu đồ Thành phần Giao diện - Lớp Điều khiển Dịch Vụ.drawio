        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\nhide circle\n\nclass \&quot;FrmDichVu\\n(from Giao dien)\&quot; as FrmDichVu &lt;&lt;boundary&gt;&gt; {\n  Frm_Load()\n  Tai()\n  cboLuot_SelectedIndexChanged()\n  btnGhi_Click()\n  btnDong_Click()\n}\n\nclass \&quot;DichVuService\\n(from Dieu khien)\&quot; as DichVuService &lt;&lt;control&gt;&gt; {\n  LayPhieuDangO()\n  LayDichVu()\n  LayLichSu()\n  GhiNhan()\n}\n\nclass \&quot;PhieuDatPhong\\n(from Thuc the)\&quot; as PhieuDatPhong {\n  SoPhieuDat : String\n  NgayLap : DateTime\n  NgayNhan : Date\n  NgayTraDuKien : Date\n  TienCoc : Decimal\n  KenhDat : String\n  TrangThai : String\n  NgayNhanThucTe : DateTime\n  NgayTraThucTe : DateTime\n  --\n  themPhieuDat()\n  layTrangThai()\n  capNhatTrangThai()\n  layPhieuDangO()\n  demPhieuDat()\n}\n\nclass \&quot;PhieuSuDungDV\\n(from Thuc the)\&quot; as PhieuSuDungDV {\n  SoPhieuSDDV : String\n  NgaySuDung : Date\n  --\n  timPhieu()\n  taoPhieu()\n  layLichSu()\n  tongHopTheoDichVu()\n}\n\nclass \&quot;DichVu\\n(from Thuc the)\&quot; as DichVu {\n  MaDV : String\n  TenDV : String\n  DonViTinh : String\n  DonGia : Decimal\n  --\n  themDichVu()\n  layDanhSach()\n  layDonGia()\n}\n\nclass \&quot;ChiTietPhieuSuDungDV\\n(from Thuc the)\&quot; as ChiTietPhieuSuDungDV {\n  SoLuong : Integer\n  DonGia : Decimal\n  ThanhTien : Decimal\n  --\n  kiemTraDichVu()\n  themChiTiet()\n  congDonSoLuong()\n}\n\nFrmDichVu -right-&gt; DichVuService\nDichVuService -up-&gt; PhieuDatPhong\nDichVuService -right-&gt; PhieuSuDungDV\nDichVuService -down-&gt; DichVu\nDichVuService -down-&gt; ChiTietPhieuSuDungDV\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="_nGcP8eMneEMTGKeH-Zw-1">
