        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\n\nactor \&quot;: NV phuc vu phong\&quot; as NV\nparticipant \&quot;: FrmPhongTienNghi\&quot; as GUI\nparticipant \&quot;: PhongTienNghiService\&quot; as BLL\nparticipant \&quot;: PhieuLapDat\&quot; as Phieu\nparticipant \&quot;: TienNghi\&quot; as TN\n\nNV -&gt; GUI : Mo tab Lap dat\nactivate GUI\nGUI -&gt; BLL : LayTienNghi(), LayPhong()\nactivate BLL\nBLL --&gt; GUI : ds tien nghi, ds phong\ndeactivate BLL\n\nNV -&gt; GUI : Chon tien nghi, phong, ngay, tinh trang, NV\nNV -&gt; GUI : Nhan \&quot;Lap phieu\&quot;\n\nGUI -&gt; BLL : LapDat(soPhieu, maTN, soPhong, ngay, tinhTrang, maNV, ghiChu)\nactivate BLL\n\nBLL -&gt; BLL : Kiem tra thong tin bat buoc\nBLL -&gt; Phieu : themPhieuLapDat(...)\nactivate Phieu\nPhieu --&gt; BLL : ket qua (UNIQUE MaTienNghi + NgayLap)\ndeactivate Phieu\n\nalt them thanh cong\n    BLL -&gt; TN : capNhatTinhTrang(maTN, tinhTrang)\n    activate TN\n    TN --&gt; BLL\n    deactivate TN\n    \n    BLL --&gt; GUI : KetQuaXuLy.Ok\nelse thiet bi da lap cho phong khac trong ngay\n    BLL --&gt; GUI : KetQuaXuLy.Fail\nend\n\ndeactivate BLL\nGUI --&gt; NV : Thong bao ket qua\ndeactivate GUI\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="qHiuWlIamJ_OszzEOrJU-1">
