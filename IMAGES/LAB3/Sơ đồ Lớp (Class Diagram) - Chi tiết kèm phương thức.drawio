        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\nhide circle\n\nclass TienNghi {\n  MaTienNghi : String\n  SoThuTu : Integer\n  TinhTrangHienTai : String\n  themTienNghi()\n  layDanhSach()\n  capNhatTinhTrang()\n}\n\nclass ChiTietPhieuDenBu {\n  MucDoThietHai : String\n  SoTien : Decimal\n  themChiTiet()\n}\n\nclass NhanVien {\n  MaNV : String\n  HoTen : String\n  VaiTro : String\n  SoDienThoai : String\n  themNhanVien()\n  layDanhSach()\n}\n\nclass HoaDon {\n  SoHoaDon : String\n  NgayLap : DateTime\n  SoNgayTinhTien : Integer\n  TienPhong : Decimal\n  TienDichVu : Decimal\n  TongTien : Decimal\n  TrangThai : String\n  themHoaDon()\n  layTrangThai()\n  capNhatTrangThai()\n  tongDoanhThu()\n}\n\nclass ThanhToan {\n  MaThanhToan : String\n  NgayThanhToan : DateTime\n  HinhThuc : String\n  SoTien : Decimal\n  themGiaoDich()\n  tongDaThanhToan()\n}\n\nclass LoaiTienNghi {\n  MaLoaiTN : String\n  TenLoaiTN : String\n  themLoaiTN()\n  layDanhSach()\n}\n\nclass PhieuLapDat {\n  SoPhieuLapDat : String\n  NgayLap : Date\n  TinhTrang : String\n  GhiChu : String\n  themPhieuLapDat()\n  layLichSu()\n  layTienNghiTheoPhong()\n}\n\nclass PhieuDenBu {\n  SoPhieuDenBu : String\n  NgayLap : DateTime\n  TongTien : Decimal\n  themPhieuDenBu()\n  themChiTietDenBu()\n  tongDenBu()\n}\n\nclass ChiTietPhieuSuDungDV {\n  SoLuong : Integer\n  DonGia : Decimal\n  ThanhTien : Decimal\n  kiemTraDichVu()\n  themChiTiet()\n  congDonSoLuong()\n}\n\nclass PhieuSuDungDV {\n  SoPhieuSDDV : String\n  NgaySuDung : Date\n  timPhieu()\n  taoPhieu()\n  layLichSu()\n  tongHopTheoDichVu()\n}\n\nclass PhieuDatPhong {\n  SoPhieuDat : String\n  NgayLap : DateTime\n  NgayNhan : Date\n  NgayTraDuKien : Date\n  TienCoc : Decimal\n  KenhDat : String\n  TrangThai : String\n  NgayNhanThucTe : DateTime\n  NgayTraThucTe : DateTime\n  themPhieuDat()\n  layTrangThai()\n  capNhatTrangThai()\n  layPhieuDangO()\n  demPhieuDat()\n}\n\nclass QuyDinhDenBu {\n  MaQuyDinh : String\n  MucDoThietHai : String\n  MucDenBu : Decimal\n  themQuyDinh()\n  layDanhSach()\n}\n\nclass Phong {\n  SoPhong : String\n  SoNguoiToiDa : Integer\n  DonGiaNgay : Decimal\n  TrangThai : String\n  themPhong()\n  layDanhSach()\n  laySucChua()\n  capNhatTrangThai()\n}\n\nclass DichVu {\n  MaDV : String\n  TenDV : String\n  DonViTinh : String\n  DonGia : Decimal\n  themDichVu()\n  layDanhSach()\n  layDonGia()\n}\n\nclass KhachHang {\n  MaKhach : String\n  HoTen : String\n  SoCMND : String\n  QuocTich : String\n  SoDienThoai : String\n  themKhach()\n  layDanhSach()\n}\n\nclass KhuVuc {\n  MaKhuVuc : String\n  TenKhuVuc : String\n  themKhuVuc()\n  layDanhSach()\n}\n\nclass ChiTietDatPhong {\n  SoNguoi : Integer\n  themChiTiet()\n  kiemTraTrungLich()\n  laySoNguoiDangKy()\n  layChiTiet()\n}\n\nclass NguoiLuuTru {\n  MaNguoiLT : Integer\n  HoTen : String\n  SoCMND : String\n  QuocTich : String\n  themNguoiLuuTru()\n  demNguoiLuuTru()\n  layDanhSach()\n}\n\nLoaiTienNghi \&quot;1\&quot; -- \&quot;0..*\&quot; TienNghi\nLoaiTienNghi \&quot;1\&quot; -- \&quot;0..*\&quot; QuyDinhDenBu\nTienNghi \&quot;1\&quot; -- \&quot;10..*\&quot; ChiTietPhieuDenBu\nTienNghi \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuLapDat\nPhieuLapDat \&quot;0..*\&quot; -- \&quot;1\&quot; Phong\nPhieuDenBu \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhieuDenBu\nPhieuDenBu \&quot;0..*\&quot; -- \&quot;1\&quot; Phong\nKhuVuc \&quot;1\&quot; -- \&quot;1..*\&quot; Phong\nPhong \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietDatPhong\nDichVu \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhieuSuDungDV\nChiTietDatPhong \&quot;1..*\&quot; -- \&quot;0..*\&quot; ChiTietPhieuSuDungDV\nPhieuSuDungDV \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhieuSuDungDV\nChiTietDatPhong \&quot;1\&quot; -- \&quot;0..*\&quot; NguoiLuuTru\nPhieuDatPhong \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietDatPhong\nPhieuDatPhong \&quot;0..*\&quot; -- \&quot;1\&quot; KhachHang\nNhanVien \&quot;1\&qu