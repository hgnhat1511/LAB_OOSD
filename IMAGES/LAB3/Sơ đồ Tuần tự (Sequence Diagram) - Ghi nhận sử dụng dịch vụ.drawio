        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\n\nactor \&quot;: Nhan vien\&quot; as NV\nparticipant \&quot;: FrmDichVu\&quot; as GUI\nparticipant \&quot;: DichVuService\&quot; as BLL\nparticipant \&quot;: PhieuDatPhong\&quot; as PhieuDat\nparticipant \&quot;: DichVu\&quot; as DV\nparticipant \&quot;: PhieuSuDungDV\&quot; as PhieuSD\nparticipant \&quot;: ChiTietPhieuSuDungDV\&quot; as CT\n\nNV -&gt; GUI : Chon phieu dang o, dich vu, ngay, so luong\nactivate GUI\nGUI -&gt; BLL : GhiNhan(soPhieuDat, soPhong, ngay, maNV, maDV, soLuong)\nactivate BLL\n\nBLL -&gt; PhieuDat : layTrangThai(soPhieuDat)\nactivate PhieuDat\nPhieuDat --&gt; BLL : \&quot;Dang o\&quot;\ndeactivate PhieuDat\n\nBLL -&gt; DV : layDonGia(maDV)\nactivate DV\nDV --&gt; BLL : DonGia\ndeactivate DV\n\nBLL -&gt; PhieuSD : timPhieu(soPhieuDat, soPhong, ngay)\nactivate PhieuSD\nPhieuSD --&gt; BLL : soPhieuSDDV / null\ndeactivate PhieuSD\n\nopt chua co phieu cua phong trong ngay\n    BLL -&gt; PhieuSD : taoPhieu(soPhieuDat, soPhong, ngay, maNV)\n    activate PhieuSD\n    PhieuSD --&gt; BLL\n    deactivate PhieuSD\nend\n\nBLL -&gt; CT : kiemTraDichVu(soPhieuSDDV, maDV)\nactivate CT\nCT --&gt; BLL : da co / chua co\ndeactivate CT\n\nalt dich vu da co trong phieu ngay do\n    BLL -&gt; CT : congDonSoLuong(soLuong)\n    activate CT\n    CT --&gt; BLL\n    deactivate CT\nelse chua co\n    BLL -&gt; CT : themChiTiet(maDV, soLuong, DonGia)\n    activate CT\n    CT --&gt; BLL\n    deactivate CT\nend\n\nBLL --&gt; GUI : KetQuaXuLy.Ok\ndeactivate BLL\nGUI --&gt; NV : Hien thi lich su, thanh tien\ndeactivate GUI\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Yf7-RiR8A9J6rsGmcSg8-1">
