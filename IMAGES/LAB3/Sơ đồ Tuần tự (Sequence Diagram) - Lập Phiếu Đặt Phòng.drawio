        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\n\nactor \&quot;: NV le tan\&quot; as NV\nparticipant \&quot;: FrmDatPhong\&quot; as GUI\nparticipant \&quot;: DatPhongService\&quot; as BLL\nparticipant \&quot;: Phong\&quot; as Phong\nparticipant \&quot;: ChiTietDatPhong\&quot; as CT\nparticipant \&quot;: PhieuDatPhong\&quot; as Phieu\n\nNV -&gt; GUI : Chon khach, le tan, kenh dat, ngay nhan/tra, tien coc\nNV -&gt; GUI : Chon phong va so nguoi\nGUI -&gt; GUI : Them phong vao danh sach chon\nNV -&gt; GUI : Nhan \&quot;Lap phieu\&quot;\nactivate GUI\nGUI -&gt; BLL : TaoDatPhong(so, maKhach, maNV, nhan, tra, coc, ds)\nactivate BLL\n\nBLL -&gt; BLL : Kiem tra du lieu, ngay tra &gt;= ngay nhan\nBLL -&gt; Phong : laySucChua(soPhong)\nactivate Phong\nPhong --&gt; BLL : SoNguoiToiDa\ndeactivate Phong\n\nBLL -&gt; CT : kiemTraTrungLich(soPhong, nhan, tra)\nactivate CT\nCT --&gt; BLL : ket qua kiem tra\ndeactivate CT\n\nalt so nguoi &lt;= suc chua va khong trung lich\n    BLL -&gt; Phieu : themPhieuDat(..., \&quot;Da dat\&quot;)\n    activate Phieu\n    Phieu --&gt; BLL\n    deactivate Phieu\n    \n    BLL -&gt; CT : themChiTiet(soPhieu, soPhong, soNguoi)\n    activate CT\n    CT --&gt; BLL\n    deactivate CT\n    \n    BLL -&gt; BLL : capNhatTrangThai(\&quot;Da dat\&quot;)\n    \n    BLL --&gt; GUI : KetQuaXuLy.Ok\nelse vuot suc chua hoac trung lich\n    BLL --&gt; GUI : KetQuaXuLy.Fail (rollback)\nend\n\ndeactivate BLL\nGUI --&gt; NV : Thong bao ket qua lap phieu\ndeactivate GUI\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CiZ5inaZL06Ps5L0k3zG-1">
