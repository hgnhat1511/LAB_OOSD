        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\nhide empty methods\nhide circle\n\nclass \&quot;FrmThongKe\\n(from Giao dien)\&quot; as FrmThongKe &lt;&lt;boundary&gt;&gt; {\n  btnTK_Click()\n  btnDong_Click()\n}\n\nclass \&quot;ThongKeService\\n(from Dieu khien)\&quot; as ThongKeService &lt;&lt;control&gt;&gt; {\n  TongHop()\n  DichVu()\n}\n\nclass \&quot;PhieuDatPhong\\n(from Thuc the)\&quot; as PhieuDatPhong {\n  SoPhieuDat : String\n  NgayLap : DateTime\n  NgayNhan : Date\n  NgayTraDuKien : Date\n  TienCoc : Decimal\n  KenhDat : String\n  TrangThai : String\n  NgayNhanThucTe : DateTime\n  NgayTraThucTe : DateTime\n  --\n  themPhieuDat()\n  layTrangThai()\n  capNhatTrangThai()\n  layPhieuDangO()\n  demPhieuDat()\n}\n\nclass \&quot;HoaDon\\n(from Thuc the)\&quot; as HoaDon {\n  SoHoaDon : String\n  NgayLap : DateTime\n  SoNgayTinhTien : Integer\n  TienPhong : Decimal\n  TienDichVu : Decimal\n  TongTien : Decimal\n  TrangThai : String\n  --\n  themHoaDon()\n  layTrangThai()\n  capNhatTrangThai()\n  tongDoanhThu()\n}\n\nclass \&quot;PhieuDenBu\\n(from Thuc the)\&quot; as PhieuDenBu {\n  SoPhieuDenBu : String\n  NgayLap : DateTime\n  TongTien : Decimal\n  --\n  themPhieuDenBu()\n  themChiTietDenBu()\n  tongDenBu()\n}\n\nclass \&quot;PhieuSuDungDV\\n(from Thuc the)\&quot; as PhieuSuDungDV {\n  SoPhieuSDDV : String\n  NgaySuDung : Date\n  --\n  timPhieu()\n  taoPhieu()\n  layLichSu()\n  tongHopTheoDichVu()\n}\n\nclass \&quot;ChiTietPhieuSuDungDV\\n(from Thuc the)\&quot; as ChiTietPhieuSuDungDV {\n  SoLuong : Integer\n  DonGia : Decimal\n  ThanhTien : Decimal\n  --\n  kiemTraDichVu()\n  themChiTiet()\n  congDonSoLuong()\n}\n\nclass \&quot;DichVu\\n(from Thuc the)\&quot; as DichVu {\n  MaDV : String\n  TenDV : String\n  DonViTinh : String\n  DonGia : Decimal\n  --\n  themDichVu()\n  layDanhSach()\n  layDonGia()\n}\n\nFrmThongKe -right-&gt; ThongKeService\nThongKeService -up-&gt; PhieuDatPhong\nThongKeService -right-&gt; HoaDon\nThongKeService -right-&gt; PhieuDenBu\nThongKeService -down-&gt; PhieuSuDungDV\nThongKeService -down-&gt; ChiTietPhieuSuDungDV\nThongKeService -down-&gt; DichVu\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="FgNdAH4LpIbZEuNYBh7s-161">
